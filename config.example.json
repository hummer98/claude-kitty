{
  "view": {
    "left": "main",
    "pinned": [],
    "restore": [["dev-a"], ["dev-b"]],
    "guard": []
  },
  "state": {
    "base_background": "#232627",
    "colors": {
      "working": {"background": "#22282e", "name": null},
      "waiting": {"background": "#2e2a22", "name": 208},
      "done":    {"background": "#222b25", "name": 108},
      "idle":    {"background": null,      "name": 245}
    },
    "done_dwell_seconds": 2,
    "watch_sockets": null,
    "notice": {"contains": [], "prefix": []},
    "subagent_colors": {"running": 110}
  },
  "kitty": {
    "desktop": null,
    "maximize": false
  },
  "browser": {
    "enabled": true,
    "command": null,
    "profile_root": null
  },
  "lang": {
    "enabled": true,
    "language": null,
    "threshold": 0.3,
    "head": 200,
    "min": 20
  },
  "guard_hook": {
    "wait_loop_check": true,
    "guards": {
      "presenting": {
        "enabled": false,
        "process": "^/usr/bin/slides-app --present",
        "command": "test -e /tmp/presenting",
        "command_timeout": 2,
        "paths": ["~/.config/window-layout"],
        "commands": [
          "claude-view",
          {"regex": "^kitten @ (focus|resize|goto)"},
          {"program": "^svcctl(\\.py)?$", "value_options": ["--owner"],
           "block": ["deploy", {"sub": "config", "if_any": ["--set"]}, {"sub": "reset", "unless_any": ["--dry-run"]}],
           "allow_owner": {"file": "$XDG_RUNTIME_DIR/svcctl/launched.json", "option": "--owner", "env": "SVCCTL_OWNER"}}
        ],
        "allow_commands": ["claude-view status"],
        "message": "発表が終わるまで画面を動かさないでください（{name}: {condition}）。"
      }
    }
  },
  "session_stats": {
    "master": "main",
    "roles": ["dev-a", "dev-b"],
    "role_dir_prefix": "",
    "rephrase": [["again", "「もう一度」", "もう一度|さっきも言った"]],
    "echo": [["task_tools", "\"The task tools haven't been used recently…\"", "\\s*The task tools haven't been used recently"]],
    "redact": [],
    "glossary": null,
    "projects": "~/.claude/projects",
    "home_project": "",
    "out_dir": "",
    "notes": [],
    "timezone": ""
  },
  "roster": {
    "models": {"dev-a": "opus"},
    "ignore": ["scratch"],
    "generations": 5,
    "keep_absent_hours": 24,
    "claude": {"~/work/app": "~/bin/claude-bypass-app"}
  },
  "relay": {
    "enabled": true,
    "name": "linux-desk",
    "receivers": ["left"],
    "max_bytes": 16384,
    "rate": {"count": 30, "per_seconds": 600},
    "peers": {
      "mac-a": {"host": "mac-a.local", "user": "taro", "port": 22}
    }
  },
  "model_policy": {
    "enabled": false,
    "away_minutes": 20,
    "away_model": "haiku",
    "keep": ["review", "レビュー", "評価", "verify", "検証", "調べ", "guide"]
  },
  "disk_watch": {
    "enabled": true,
    "paths": ["/tmp"],
    "thresholds": [70, 85],
    "notify_role": null,
    "interval_sec": 60
  },
  "statusline": {
    "context": true,
    "context_thresholds": [200000, 400000],
    "context_colors": [186, 173],
    "weekly_roles": ["left"],
    "weekly_thresholds": [85, 95],
    "weekly_colors": [208, 196],
    "waits": true
  },
  "waits": {
    "enabled": true,
    "poll_seconds": 60,
    "master_role": null,
    "catchup_hours": 12,
    "claude": ["claude", "-p"],
    "prompt_timeout_seconds": 1800,
    "cmd_timeout_seconds": 60,
    "body_max": 1000,
    "keep_days": 7
  },
  "prompt_suffix": {
    "enabled": true,
    "language": "ja",
    "suffixes": {},
    "number_lists": false,
    "notice": true,
    "screenshot_dir": null,
    "screenshot_by_cwd": {},
    "screenshot_names": null,
    "screenshot_max_age_min": 120
  }
}

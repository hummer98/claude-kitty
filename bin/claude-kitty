#!/bin/bash
# claude-code を並べた kitty を起動する。設定の kitty.maximize で最大化し、kitty.desktop で仮想デスクトップへ移す
# （移動は KDE Plasma の KWin 用。どちらも既定はしない）。
# claude-kitty doctor [--json] は、入っているもの・動くものを調べて直し方を出す。
# kitty の場所は $CLAUDE_KITTY_KITTY で変えられる（既定は公式インストーラの ~/.local/kitty.app、無ければ PATH の kitty、
# macOS の kitty.app）。セッションを省くと ~/.config/kitty/claude3.session（install.sh --kitty のリンク）、
# 無ければリポジトリの kitty/claude3.session。
# claude-code の中から起動すると CLAUDE_* の環境変数を引き継ぎ、子の claude が
# 「子セッション」扱いになって会話記録を保存しなくなるので、それらを消してから起動する。
# 窓のクラスは $CLAUDE_KITTY_CLASS（既定 kitty-claude。Linux だけ。macOS の kitty には --class が無い）、起動の形は $CLAUDE_KITTY_START_AS（既定は kitty.maximize が
# true なら maximized、そうでなければ normal）。
# 試験用の kitty を別のクラスで起動したときは、本物の窓を動かさないよう KWin の移動をしない。
# macOS: kitty の --detach は使えないので、nohup で切り離して起動する。kitty.maximize・kitty.desktop（KWin 用）は
# 行わず、設定してあれば注意だけ出す。
# 自分の場所（~/.local/bin のリンクの先）。readlink -f は古い macOS に無いので、リンクを 1 段ずつたどる
self=$0
while [ -L "$self" ]; do
	t=$(readlink "$self")
	case "$t" in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac
done
here=$(cd -P "$(dirname "$self")" && pwd) || exit 1
if [ "$*" = --version ]; then  # 版は lib/version.py が VERSION から読む（ほかのコマンドと同じ所）
	exec python3 "$here/../lib/version.py" claude-kitty
fi
if [ "${1:-}" = doctor ]; then  # 入っているもの・動くものを調べる（読むだけ。lib/doctor.py）
	shift
	exec python3 "$here/../lib/doctor.py" "$@"
fi
os=${CLAUDE_KITTY_UNAME:-$(uname -s)}   # テストで偽の OS にするため
session=${1:-${KITTY_CONFIG_DIRECTORY:-${XDG_CONFIG_HOME:-$HOME/.config}/kitty}/claude3.session}
[ -n "${1:-}" ] || [ -e "$session" ] || session=$here/../kitty/claude3.session
kitty=${CLAUDE_KITTY_KITTY:-}
if [ -z "$kitty" ]; then
	for k in "$HOME/.local/kitty.app/bin/kitty" "$(command -v kitty 2>/dev/null)" /Applications/kitty.app/Contents/MacOS/kitty; do
		[ -n "$k" ] && [ -x "$k" ] && { kitty=$k; break; }
	done
	[ -n "$kitty" ] || { echo "claude-kitty: kitty が見つからない（~/.local/kitty.app・PATH・/Applications を探した。\$CLAUDE_KITTY_KITTY で場所を指す）" >&2; exit 1; }
fi
class=${CLAUDE_KITTY_CLASS:-kitty-claude}
read -r desktop maximize < <(python3 "$here/../lib/config.py" kitty-launch)
if [ "$os" = Darwin ]; then
	# 最大化と仮想デスクトップへの移動は KWin 用なので行わない（設定があれば知らせる）
	if [ "${maximize:-0}" = 1 ]; then
		echo "claude-kitty: 注意: macOS では kitty.maximize を使わない（最大化しないで起動する。大きさは kitty の remember_window_size などで決める）" >&2
	fi
	case "$desktop" in ''|-) ;; *) echo "claude-kitty: 注意: macOS では kitty.desktop を使わない（仮想デスクトップへは移さない）" >&2 ;; esac
	maximize=0 desktop=-
fi
if [ "${maximize:-0}" = 1 ]; then start_as=${CLAUDE_KITTY_START_AS:-maximized}; else start_as=${CLAUDE_KITTY_START_AS:-normal}; fi
# この道具自身の設定（CLAUDE_KITTY_* / CLAUDE_VIEW_*）は残し、中の claude-view に届ける。
# 呼んだ側の端末のものも消す（kitty は環境をそのまま各ペインに渡すので、中の道具が「まだその端末の中に居る」と読み違える）:
# - CMUX_* / C11_* / GHOSTTY_*: cmux（c11）の中から起動すると、中の claude が c11 用の hook を動かして失敗する
#   （「SessionStart hook failed」）。シェルは ghostty 用のシェル統合を読み込む
# - TMUX / TMUX_PANE / TERM_PROGRAM / TERM_PROGRAM_VERSION: tmux や別の端末の中に居ると読まれる（kitty は TERM_PROGRAM を置かない）
# - KITTY_WINDOW_ID / KITTY_LISTEN_ON / KITTY_PID / WINDOWID: 別の kitty の中から起動したときの、元の kitty のペインとソケット。
#   新しい kitty がソケットを開かない設定だと残り、claude-state などが元の kitty のペインを塗る
# ほかにも消すものは $CLAUDE_KITTY_UNSET に空白で区切って書く（名前か、「FOO_*」の形の接頭辞）
unset_names="TMUX TMUX_PANE TERM_PROGRAM TERM_PROGRAM_VERSION KITTY_WINDOW_ID KITTY_LISTEN_ON KITTY_PID WINDOWID"
unset_prefixes="CMUX_ C11_ GHOSTTY_"
set -f  # 下の for は空白で区切るだけ（「*」をファイル名に広げない）
for w in ${CLAUDE_KITTY_UNSET:-}; do
	case $w in
	*[!A-Za-z0-9_*]*|[0-9]*|'*') echo "claude-kitty: CLAUDE_KITTY_UNSET の「${w}」は名前か接頭辞（FOO_*）でないので使わない" >&2 ;;
	*'*') case ${w%'*'} in *'*'*) echo "claude-kitty: CLAUDE_KITTY_UNSET の「${w}」は名前か接頭辞（FOO_*）でないので使わない" >&2 ;; *) unset_prefixes="$unset_prefixes ${w%'*'}" ;; esac ;;
	*) unset_names="$unset_names $w" ;;
	esac
done
for v in $(compgen -e); do  # export してある変数の名前（env の出力と違い、値の中の改行に惑わされない）
	case $v in
	CLAUDE_KITTY_*|CLAUDE_VIEW_*) continue ;;
	CLAUDE*) unset "$v"; continue ;;
	esac
	for n in $unset_names; do [ "$v" = "$n" ] && unset "$v"; done
	for n in $unset_prefixes; do case $v in "$n"*) unset "$v" ;; esac; done
done
unset unset_names unset_prefixes w n
set +f
cd ~ || exit 1
if [ "$os" = Darwin ]; then
	# --detach は macOS では使えない。端末を閉じても kitty が残るよう、nohup で切り離す。
	# --class も渡さない: macOS の kitty には無く、「Unknown flag: --class use --help.」で終わる（0.51 で確認）。
	# 背景で起動するので、そのままでは失敗しても黙って 0 で終わる。$CLAUDE_KITTY_WAIT 秒（既定 2）のうちに
	# kitty が 0 以外で終わったら、kitty のエラーを出して 1 で終わる（動き続けていれば起動できたとみなす）
	errf=$(mktemp "${TMPDIR:-/tmp}/claude-kitty.XXXXXX" 2>/dev/null) || { errf="${TMPDIR:-/tmp}/claude-kitty.$$.err"; (umask 077; : > "$errf") 2>/dev/null || errf=/dev/null; }
	nohup "$kitty" --start-as "$start_as" --session "$session" </dev/null >/dev/null 2>"$errf" &
	pid=$!
	wait_s=${CLAUDE_KITTY_WAIT:-2}
	case $wait_s in ''|*[!0-9]*) wait_s=2 ;; esac
	i=0
	while [ "$i" -lt $((wait_s * 10)) ]; do
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid"; rc=$?
			if [ "$rc" != 0 ]; then
				echo "claude-kitty: kitty が起動できなかった（終了コード ${rc}）:" >&2
				[ "$errf" != /dev/null ] && sed 's/^/  /' "$errf" >&2
				[ "$errf" != /dev/null ] && rm -f "$errf"
				exit 1
			fi
			break
		fi
		sleep 0.1
		i=$((i + 1))
	done
	[ "$errf" != /dev/null ] && rm -f "$errf"
	exit 0
fi
"$kitty" --detach --class "$class" --start-as "$start_as" --session "$session"
[ "$class" = kitty-claude ] || exit 0
case "$desktop" in ''|-|*[!0-9]*) exit 0 ;; esac   # kitty.desktop を設定していなければ、窓を動かさない
# Plasma 6 の qdbus は qdbus6・qdbus-qt6 の名前のこともある（lib/kwin.py と同じ順）
qdbus=${CLAUDE_KITTY_QDBUS:-}
if [ -z "$qdbus" ]; then
	for q in qdbus qdbus6 qdbus-qt6; do command -v "$q" >/dev/null 2>&1 && { qdbus=$q; break; }; done
fi
[ -n "$qdbus" ] || { echo "claude-kitty: qdbus が無いので kitty.desktop（デスクトップ ${desktop}）へ移せない（KDE Plasma の KWin だけ）" >&2; exit 0; }
js="${XDG_RUNTIME_DIR:-/tmp}/claude-kitty-desktop.$$.js"
max=false
[ "$maximize" = 1 ] && max=true
trap 'rm -f "$js"' EXIT
sed -e "s/@@DESKTOP@@/$desktop/" -e "s/@@MAXIMIZE@@/$max/" "$here/../lib/kitty_to_desktop.js" >"$js" || exit 1
sleep 2
id=$("$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" claude_kitty_to_desktop) &&
"$qdbus" org.kde.KWin /Scripting/Script"$id" org.kde.kwin.Script.run >/dev/null
sleep 1
"$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript claude_kitty_to_desktop >/dev/null

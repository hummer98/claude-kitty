#!/usr/bin/env python3
"""端末をまたぐ Claude Code セッションの連絡（互いに承認した端末の間、LAN の中の ssh）。詳しくは docs/relay.md。

  claude-relay pair [--name N] [--host H] [--port P]   専用の鍵を作り（無ければ）、相手に渡す 1 行を出す
  claude-relay trust NAME HOST USER 'PUBKEY' [--port P] [--yes] [--no-keyscan] [--replace-host-key]
                                   相手を登録する（authorized_keys の受け取り専用の行・relay.peers・相手の host key）
  claude-relay untrust NAME [--yes]   登録を外す
  claude-relay send PEER[/ROLE] TEXT|- [--reply-to ID]   送る（- は標準入力。ROLE を省くと相手の受け取りの役割）
  claude-relay ping PEER[/ROLE]    届くかの確認（本文なし）
  claude-relay peers               相手の一覧
  claude-relay inbox [--role R] [--deliver] [--json]   受信箱を見る（--deliver は渡す文を出して delivered/ へ移す）
  claude-relay status [SESSION_ID]  ステータス行用「端末 mac-a から 1 通」（無ければ何も出さない）
  claude-relay log [-n N] [--json]  送受信の記録
  claude-relay hook EVENT          Claude Code の hook（UserPromptSubmit / Stop / SessionStart）。何が起きても exit 0
  claude-relay recv --from NAME    sshd の強制コマンド（authorized_keys が呼ぶ。人は呼ばない）
"""
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))


def cmd_hook(event, env):
    """hook。stdout には渡すときの JSON だけを出す（UserPromptSubmit では stdout が文脈に入るため）。"""
    import relay
    try:
        text = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
        try:
            payload = json.loads(text) if text.strip() else {}
        except ValueError:
            payload = {}
        got = relay.hook_output(event, payload if isinstance(payload, dict) else {}, env)
        if got:
            out, (role, rest) = got
            # 先に出して flush する（印を外す kitten の待ちで hook が時間切れになっても、渡す文は届くように）
            sys.stdout.write(json.dumps(out, ensure_ascii=False))
            sys.stdout.flush()
            relay.finish(env, role, rest)
    except BaseException as e:  # noqa: BLE001 — hook は Claude Code を止めない
        relay.hook_log_error(env, event, f"{type(e).__name__}: {e}")
    return 0


def cmd_recv(argv, env):
    import relay
    sender = argv[1] if len(argv) == 2 and argv[0] == "--from" else None
    try:
        data = sys.stdin.buffer.read(1024 * 1024 + relay.STDIN_SLACK + 1)
    except (OSError, AttributeError):
        data = b""
    line, rc = relay.receive(env, sender, env.get("SSH_ORIGINAL_COMMAND"), data)
    print(line)
    return rc


def confirm(question, yes):
    if yes:
        return True
    if not sys.stdin.isatty():
        print("claude-relay: 端末でないので確認できない（--yes で確認を省く）", file=sys.stderr)
        return False
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def guess_host():
    import socket
    h = socket.gethostname() or "localhost"
    return h if "." in h else h + ".local"


def cmd_pair(a, env):
    import getpass

    import relay
    from config import load_relay_config
    try:
        conf = load_relay_config(env)
    except ValueError as e:
        print(f"claude-relay: {e}", file=sys.stderr)
        return 2
    name = a.name or conf["name"] or guess_host().split(".")[0]
    if not relay.NAME_RE.match(name):
        print(f"claude-relay: 端末名に使えない: {name!r}（--name で英数字と . _ - の名前を）", file=sys.stderr)
        return 2
    try:
        pub, created = relay.ensure_key(env, name)
    except (RuntimeError, ValueError, OSError) as e:
        print(f"claude-relay: {e}", file=sys.stderr)
        return 1
    host = a.host or guess_host()
    user = getpass.getuser()
    port = f" --port {a.port}" if a.port and a.port != 22 else ""
    print(f"連絡用の鍵: {relay.key_path(env)}（{'新しく作った' if created else '前からある'}。指紋 {relay.fingerprint(pub.split()[1])}）")
    print(f"相手の端末で次の 1 行を実行してもらう（この端末を「{name}」として登録する）:\n")
    print(f"  claude-relay trust {name} {host} {user} '{pub}'{port}\n")
    print("- ホスト名は相手から届く名前にする（違えば --host で。LAN の IP でもよい）。")
    print("- 相手からも送ってもらうなら、相手の pair の 1 行をこの端末で trust する（両方が trust して双方向）。")
    print("- 受け取るには、この端末の sshd が動いていること（claude-kitty doctor の「relay: sshd」）。")
    if not conf["name"]:
        print(f"- 設定の relay.name に「{name}」と書いておくと、次から同じ名前を出す（docs/config.md）。")
    return 0


def _write_checked(relay, env, before, writes):
    """ロックを取ってから、読んだときの中身（before: パス → 文字列）と今が同じか確かめ、同じなら writes を順に行う。
    確認を待っている間にほかの道具・手で変わっていたら、黙って上書きしないよう何も書かずに 1 を返す。"""
    try:
        with relay.locked(relay.conf_dir(env), timeout=5.0):
            for p, text in before.items():
                if relay.read_text_or_empty(p) != text:
                    print(f"claude-relay: {p} が読んだあとに変わった。何も書いていない（もう一度実行する）", file=sys.stderr)
                    return 1
            for w in writes:
                w()
    except relay.Refused as e:
        print(f"claude-relay: {e}（何も書いていない）", file=sys.stderr)
        return 1
    except (OSError, ValueError) as e:
        print(f"claude-relay: 書けない: {e}", file=sys.stderr)
        return 1
    return 0


def _plan_peer(data, name, peer):
    peers = data.setdefault("relay", {}).setdefault("peers", {})
    old = peers.get(name)
    peers[name] = peer
    return old


def cmd_trust(a, env):
    import relay
    from config import load_relay_config
    try:
        relay._checked(a.name, "端末")
        if not relay.HOST_RE.match(a.host):
            raise ValueError(f"ホスト名が正しくない: {a.host!r}")
        if not relay.USER_RE.match(a.user):
            raise ValueError(f"ユーザー名が正しくない: {a.user!r}")
        if not 1 <= a.port <= 65535:
            raise ValueError(f"ポートは 1〜65535: {a.port}")
        line = relay.ak_line(a.name, a.pubkey)
        load_relay_config(env)                        # 壊れた設定に書き足さない
        cpath, data = relay.read_config_data(env)
        c_text = relay.read_text_or_empty(cpath)
        ak = relay.authorized_keys_path(env)
        ak_text = relay.read_text_or_empty(ak)
        kh = relay.known_hosts_path(env)
        kh_text = relay.read_text_or_empty(kh)
    except ValueError as e:                           # UnicodeDecodeError も
        print(f"claude-relay: {e}", file=sys.stderr)
        return 2
    new_ak, action = relay.ak_replace(ak_text, a.name, line)
    peer = {"host": a.host, "user": a.user, "port": a.port}
    old = _plan_peer(data, a.name, peer)
    _typ, b64 = relay.parse_pubkey(a.pubkey)
    print(f"## 端末 {a.name}（{a.user}@{a.host}:{a.port}）を登録する")
    mark = {"add": "+", "replace": "~", "same": "="}[action]
    print(f"{mark} {ak} に受け取り専用の行（この鍵でできるのは claude-relay recv だけ。鍵の指紋 {relay.fingerprint(b64)}）:")
    print(f"    {line}")
    dup = relay.ak_other_lines_with_key(ak_text, b64)
    if dup:
        # sshd は先に合った行を使う。強制コマンドの無い行が残っていると、この鍵でシェルが開けてしまう
        print(f"! {ak} に同じ鍵の別の行がある（強制コマンドが効かない）。その行を消してから trust をもう一度。何も書いていない")
        return 1
    print(f"{'=' if old == peer else '~' if old else '+'} {cpath} の relay.peers.{a.name} = {json.dumps(peer, ensure_ascii=False)}")
    marker = relay.host_marker(a.host, a.port)
    new_kh = kh_text
    key_changed = False
    if not a.no_keyscan:
        scanned = relay.keyscan(env, a.host, a.port)
        if scanned:
            have = relay.kh_lines(kh_text, marker)
            same = sorted(have) == sorted(x for x, _t, _f in scanned)
            print(f"{'=' if same else '~' if have else '+'} {kh} に相手の host key（送るときに相手を確かめる。"
                  "相手の端末で ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub などと見比べる）:")
            for _x, t, fp in scanned:
                print(f"    {t} {fp}")
            if have and not same:
                key_changed = True
                print("! 前に登録した host key と違う。相手が sshd を入れ直したのでなければ、別の機械に繋がっているかもしれない")
            new_kh = relay.kh_replace(kh_text, marker, [x for x, _t, _f in scanned])
        else:
            print(f"! {marker} の host key を取れない（相手の sshd が動いていない・名前が引けない）。"
                  "このままでは送れないので、相手の sshd が動いてから trust をもう一度")
    if isinstance(old, dict) and isinstance(old.get("host"), str):
        # ホストかポートを変えた: 前の宛先の host key は、ほかの相手が使っていなければ外す（古い鍵を信じ続けない）
        was = relay.host_marker(old["host"], old.get("port", 22))
        others = [p for n, p in data["relay"]["peers"].items() if n != a.name and isinstance(p, dict)]
        if was != marker and not any(relay.host_marker(p.get("host"), p.get("port", 22)) == was for p in others) \
                and relay.kh_lines(new_kh, was):
            print(f"- {kh} の前の宛先（{was}）の host key")
            new_kh = relay.kh_replace(new_kh, was, [])
    if key_changed and not a.replace_host_key:
        # --yes（Claude のセッションから流すときなど）でも、変わった host key は黙って受け入れない
        print("止めた（何も書いていない）。相手に確かめて、入れ替えるなら --replace-host-key を付けてもう一度")
        return 1
    changed = new_ak != ak_text or old != peer or new_kh != kh_text
    if not changed:
        print("（変えるものは無い）")
        return 0
    if not confirm("これで登録しますか", a.yes):
        print("止めた（何も書いていない）")
        return 1
    writes = []
    if new_ak != ak_text:
        def w_ak():
            bak = relay.write_authorized_keys(env, new_ak)
            if bak:
                print(f"  （前の authorized_keys は {bak}）")
        writes.append(w_ak)
    if old != peer:
        writes.append(lambda: relay.write_config_data(cpath, data))
    if new_kh != kh_text:
        writes.append(lambda: relay.write_private(kh, new_kh))
    if _write_checked(relay, env, {ak: ak_text, cpath: c_text, kh: kh_text}, writes):
        return 1
    p = relay.ssh_dir_problem(env)
    if p:
        print(f"! {p}")
    print(f"登録した。届くかは claude-relay ping {a.name}")
    return 0


def cmd_untrust(a, env):
    import relay
    try:
        relay._checked(a.name, "端末")
        cpath, data = relay.read_config_data(env)
        c_text = relay.read_text_or_empty(cpath)
        ak = relay.authorized_keys_path(env)
        ak_text = relay.read_text_or_empty(ak)
        kh = relay.known_hosts_path(env)
        kh_text = relay.read_text_or_empty(kh)
    except ValueError as e:
        print(f"claude-relay: {e}", file=sys.stderr)
        return 2
    new_ak, action = relay.ak_replace(ak_text, a.name, None)
    peers = data.get("relay", {}).get("peers", {})
    old = peers.pop(a.name, None)
    new_kh = kh_text
    if isinstance(old, dict) and isinstance(old.get("host"), str):
        port = old.get("port", 22)
        marker = relay.host_marker(old["host"], port)
        shared = any(isinstance(p, dict) and relay.host_marker(p.get("host"), p.get("port", 22)) == marker
                     for p in peers.values())
        if not shared:
            new_kh = relay.kh_replace(kh_text, marker, [])
    print(f"## 端末 {a.name} の登録を外す")
    print(f"{'-' if action == 'remove' else '='} {ak} の claude-relay:{a.name} の行{'' if action == 'remove' else '（無い）'}")
    print(f"{'-' if old is not None else '='} {cpath} の relay.peers.{a.name}{'' if old is not None else '（無い）'}")
    if new_kh != kh_text:
        print(f"- {kh} の相手の host key")
    if action != "remove" and old is None and new_kh == kh_text:
        print("（変えるものは無い）")
        return 0
    if not confirm("外しますか", a.yes):
        print("止めた（何も書いていない）")
        return 1
    writes = []
    if action == "remove":
        def w_ak():
            bak = relay.write_authorized_keys(env, new_ak)
            if bak:
                print(f"  （前の authorized_keys は {bak}）")
        writes.append(w_ak)
    if old is not None:
        writes.append(lambda: relay.write_config_data(cpath, data))
    if new_kh != kh_text:
        writes.append(lambda: relay.write_private(kh, new_kh))
    if _write_checked(relay, env, {ak: ak_text, cpath: c_text, kh: kh_text}, writes):
        return 1
    print("外した")
    return 0


def cmd_peers(a, env):
    import relay
    from config import load_relay_config
    try:
        conf = load_relay_config(env)
    except ValueError as e:
        print(f"claude-relay: {e}", file=sys.stderr)
        return 2
    ak_names = relay.ak_names(relay.read_text_or_empty(relay.authorized_keys_path(env)))
    kh_text = relay.read_text_or_empty(relay.known_hosts_path(env))
    rows = []
    for name in sorted(set(conf["peers"]) | set(ak_names)):
        p = conf["peers"].get(name)
        rows.append({"name": name, "send": p is not None, "receive": name in ak_names,
                     "host_key": bool(p and relay.kh_lines(kh_text, relay.host_marker(p["host"], p["port"]))),
                     "address": f"{p['user']}@{p['host']}:{p['port']}" if p else None})
    if a.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    print(f"この端末: {conf['name'] or '（relay.name 未設定）'}、受け取りの役割: {', '.join(conf['receivers']) or '（無し）'}"
          f"{'' if conf['enabled'] else '、受け取りを止めている（relay.enabled: false）'}")
    if not rows:
        print("（登録した相手はいない。claude-relay pair と trust で登録する）")
    for r in rows:
        print(f"{r['name']}  {r['address'] or '-'}  送る:{'可' if r['send'] and r['host_key'] else '不可'}"
              f"{'' if r['host_key'] or not r['send'] else '（host key が無い）'}  受け取る:{'可' if r['receive'] else '不可'}")
    return 0


def cmd_inbox(a, env):
    import relay
    from config import load_relay_config
    try:
        conf = load_relay_config(env)
        roles = [relay._checked(a.role, "役割")] if a.role else conf["receivers"]
    except ValueError as e:
        print(f"claude-relay: {e}", file=sys.stderr)
        return 2
    if a.deliver:
        if len(roles) != 1:
            print("claude-relay: --deliver は役割を 1 つに（--role）", file=sys.stderr)
            return 2
        try:
            text, rest = relay.take(env, roles[0])
        except relay.Refused as e:
            print(f"claude-relay: {e}", file=sys.stderr)
            return 1
        if text:
            print(text, flush=True)
        relay.finish(env, roles[0], rest)
        return 0
    rows = [dict(r, role=role) for role in roles for r in relay.inbox_items(env, role)]
    if a.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    if not rows:
        print("（受信箱は空）")
    for r in rows:
        print(f"{r['id']}  {r['role']} ← {relay.sender_address(r)}  {r.get('bytes', '?')}B  {relay.head(r['body'])}")
    return 0


def cmd_status(a, env):
    import relay
    from kstate import load, state_dir, state_file
    from state import valid_session_id
    sid = a.session or env.get("CLAUDE_CODE_SESSION_ID")
    if not valid_session_id(sid):
        return 0
    rec = load(state_file(state_dir(env), sid))
    role = (rec or {}).get("role")
    if not isinstance(role, str) or not relay.NAME_RE.match(role):
        return 0
    items = relay.inbox_items(env, role)
    text = relay.summary(items)
    if items:
        try:
            unacked = relay.check_wakes(env, role)  # 送った知らせの受領を確かめる（常駐の見張りは無い）
        except (relay.Refused, OSError, ValueError):
            unacked = set()
        if any(r["id"] in unacked for r in items):
            text += "（起こす知らせが未受領）"
    sys.stdout.write(text)
    return 0


def cmd_log(a, env):
    import relay
    rows = relay.read_log(env)[-max(1, a.n):]
    if a.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    if not rows:
        print("（記録は無い）")
    for r in rows:
        who = {"in": f"← {r.get('from')}", "out": f"→ {r.get('to')}", "ping": f"ping {r.get('to')}"}.get(r.get("dir"), "")
        extra = f"  {r.get('reason')}" if r.get("reason") else (f"  {r.get('bytes')}B {r.get('head')}" if r.get("head") else "")
        if r.get("dir") == "deliver":
            who, extra = "渡した", f"  {r.get('count')} 通"
        elif r.get("dir") == "wake":
            # 起こす知らせの受領（acked = hook で渡した）・未受領（unacked）
            who = "知らせ"
            via = {"hook": "（hook で渡した）", "delivered": "（Stop・inbox --deliver などで渡った）"}.get(r.get("via"), "")
            extra = f"  {len(r.get('ids') or [])} 通{via}" + (f"  {r.get('reason')}" if r.get("reason") else "")
        if r.get("wake"):
            extra += f"  起こす知らせ: {r.get('wake')}" + (f"（{r['wake_via']}）" if r.get("wake_via") else "")
        print(relay.clean(f"{r.get('at')}  {who}  {r.get('role') or '-'}  {r.get('result') or ''}{extra}"))
    return 0


def main(argv=None):
    env = os.environ
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) == 2 and argv[0] == "hook":  # hook は毎ターン走るので、argparse を読み込まない
        return cmd_hook(argv[1], env)
    if argv[:1] == ["recv"]:  # sshd の強制コマンド。引数は authorized_keys が決める
        return cmd_recv(argv[1:], env)
    if argv == ["--version"]:
        from version import handle_version
        handle_version(argv, "claude-relay")
        return 0
    import argparse
    ap = argparse.ArgumentParser(prog="claude-relay", description="端末をまたぐ Claude Code セッションの連絡（docs/relay.md）")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("pair", help="専用の鍵を作り、相手に渡す 1 行を出す")
    p.add_argument("--name"); p.add_argument("--host"); p.add_argument("--port", type=int, default=22)
    p = sub.add_parser("trust", help="相手を登録する")
    p.add_argument("name"); p.add_argument("host"); p.add_argument("user"); p.add_argument("pubkey")
    p.add_argument("--port", type=int, default=22); p.add_argument("--yes", "-y", action="store_true")
    p.add_argument("--no-keyscan", action="store_true", help="相手の host key を取らない（known_hosts を自分で書くとき）")
    p.add_argument("--replace-host-key", action="store_true", help="前に登録した host key と違っても入れ替える（相手に確かめてから）")
    p = sub.add_parser("untrust", help="相手の登録を外す"); p.add_argument("name"); p.add_argument("--yes", "-y", action="store_true")
    p = sub.add_parser("send", help="送る"); p.add_argument("target"); p.add_argument("text"); p.add_argument("--reply-to")
    p = sub.add_parser("ping", help="届くかの確認"); p.add_argument("target")
    p = sub.add_parser("peers", help="相手の一覧"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("inbox", help="受信箱"); p.add_argument("--role"); p.add_argument("--deliver", action="store_true")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("status", help="ステータス行用"); p.add_argument("session", nargs="?")
    p = sub.add_parser("log", help="送受信の記録"); p.add_argument("-n", type=int, default=30); p.add_argument("--json", action="store_true")
    sub.add_parser("hook").add_argument("event")
    a = ap.parse_args(argv)
    if a.cmd == "send" or a.cmd == "ping":
        import relay
        body = None
        if a.cmd == "send":
            body = sys.stdin.read() if a.text == "-" else a.text
        line, rc = relay.send(env, a.target, body, reply_to=getattr(a, "reply_to", None), ping=a.cmd == "ping")
        print(line, file=sys.stdout if rc == 0 else sys.stderr)
        return rc
    return {"pair": cmd_pair, "trust": cmd_trust, "untrust": cmd_untrust, "peers": cmd_peers, "inbox": cmd_inbox,
            "status": cmd_status, "log": cmd_log}.get(a.cmd, lambda a, env: cmd_hook(a.event, env))(a, env)


if __name__ == "__main__":
    sys.exit(main())

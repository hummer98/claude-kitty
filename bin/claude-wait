#!/usr/bin/env python3
"""usage: claude-wait <名前> <セッションID> [--model <モデル>] [--rename]

--model を付けると、そのモデルで再開する（claude --resume <ID> --model <モデル>）。
--rename を付けると、再開するときにセッション名を <名前> にする（claude --resume <ID> -n <名前>）。
ただし resume では -n が効かないので、再開の前に「/rename <名前> と打ってください」と表示する。

待つ相手の JSON の kind が "bg"（Claude Code の daemon の中の背景セッション）なら、前面の claude を
/exit しても終わらない。その旨と pid を表示するだけで、自動では止めない（作業中かもしれないので）。

同じセッションがまだ別の場所（Konsole など）で動いている間は待ち、終わったらこのペインで resume する。
同じ ID を 2 つのプロセスで同時に開くと会話記録が壊れうるので、確実に終わるまで待つ:
- ~/.claude/sessions/<pid>.json は claude が書き直すたびに一瞬空になるので、読めないときは「動いている」扱い。
- JSON はプロセスの後片付けの途中で消えるので、見つけた pid そのもの（procStart で同一性を確認）が消えるまで待つ。
  procStart と比べるのは Linux だけ（/proc/<pid>/stat の起動時刻と同じ値）。macOS では Claude Code が何を書くか
  分からないので比べず、その pid が生きている間は待つ（待ちすぎる側に倒す。lib/proc.py）。
  /clear で sessionId が変わっても、その pid が生きている間は待ち続ける。
- 見当たらない状態が 3 回続いてから再開する。同じ ID の claude-wait 同士は flock で 1 つだけにする。

続きの指示（claude-roster restart が書く）: claude が終わったとき $XDG_RUNTIME_DIR/claude-wait/<ID>.next があり
（XDG_RUNTIME_DIR が無ければ /tmp/claude-kitty-<uid>。lib/rundir.py）、
この claude-wait 宛て（pid）で新しければ（5 分以内）、シェルに戻らずに、その cwd とモデルで resume し直す
（開く ID は指示の中のもの。/clear で ID が変わっていても、いまの会話に戻る。ファイルの名前は引数の ID のまま）。
そのために、claude を開いている間は $XDG_RUNTIME_DIR/claude-wait/<ID>.waiter に自分の pid を書いておく
（claude-roster はこれを見て、止めても続きを開ける claude-wait かを確認する）。
"""
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

INTERVAL = float(os.environ.get("CLAUDE_WAIT_INTERVAL", "2"))
SESSIONS = Path(os.environ.get("CLAUDE_SESSIONS_DIR", Path.home() / ".claude/sessions"))
CLAUDE = os.environ.get("CLAUDE_WAIT_CLAUDE") or "claude"  # テスト用: 偽の claude
NEEDED_MISSES = 3
TRACE = bool(os.environ.get("CLAUDE_WAIT_TRACE"))  # テスト用: 判定の変化を stderr に出す（固定の sleep で待たずに済むように）
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import proc  # noqa: E402
from rundir import runtime_dir  # noqa: E402
try:
    from roster import read_next  # noqa: E402
except Exception:  # lib が読めなくても、待って開くことはできるように（続きの指示だけ使えない）
    read_next = None


def login_shell(env=None):
    """終わったあとに入るシェル: $SHELL が bash か zsh ならそれ（macOS の既定は zsh）、ほかは bash。"""
    sh = (env if env is not None else os.environ).get("SHELL") or ""
    return sh if os.path.basename(sh) in ("bash", "zsh") else "bash"


def shell():
    sys.stdout.flush()  # exec の前に出す（バッファのまま exec すると、表示した文が消える）
    sys.stderr.flush()
    if os.environ.get("CLAUDE_WAIT_NO_SHELL"):  # テスト用
        sys.exit(0)
    sh = login_shell()
    os.execvp(sh, [sh, "-l"])


def start_time(pid):
    """起動時刻（Linux は /proc/<pid>/stat の 22 番目、macOS は sysctl。lib/proc.py）。プロセスが無ければ None。

    Linux 以外で起動時刻を読めなくても、pid が生きていれば "alive" を返す（読めないことを「終わった」と取り違えて、
    同じセッションを 2 か所で開かないように。pid の再利用は見分けられないが、待つ側に倒れる）。"""
    if not isinstance(pid, int):
        return None
    s = proc.start_time(pid)
    if s is None and not proc.is_linux() and proc.alive(pid):
        return "alive"
    return s


UNREADABLE = {}  # 読めなかった回数。壊れたまま残ったファイルで永久に待たないよう、続いたら無視する


def find_live(sid):
    """("live", pid, start, kind) / ("unsure", None, None, None) / ("none", None, None, None)。"""
    unsure = False
    try:
        files = list(SESSIONS.glob("*.json"))
    except OSError:
        return ("unsure", None, None, None)
    for f in files:
        try:
            data = json.loads(f.read_text())
            UNREADABLE.pop(f, None)
        except (OSError, ValueError):
            UNREADABLE[f] = UNREADABLE.get(f, 0) + 1
            if UNREADABLE[f] < 20:  # 書き直しの途中かもしれない（約 10 秒続けば壊れたファイルとみなす）
                unsure = True
            continue
        if data.get("sessionId") != sid:
            continue
        pid = data.get("pid") or (int(f.stem) if f.stem.isdigit() else None)
        start = start_time(pid) if pid else None
        if start is None:
            continue  # プロセスはもう無い（古いファイル）
        if not proc.proc_start_matches(data.get("procStart"), start):
            continue  # pid が別のプロセスに再利用されている（比べるのは Linux だけ）
        return ("live", pid, start, data.get("kind"))
    return ("unsure", None, None, None) if unsure else ("none", None, None, None)


def wait_free(name, sid):
    """sid を開いているプロセスが確実にいなくなるまで待つ。待ったことを表示したら True。"""
    misses, told, last = 0, False, None
    while misses < NEEDED_MISSES:
        state, pid, start, kind = find_live(sid)
        if TRACE and state != last:
            print(f"trace: {state}", file=sys.stderr, flush=True)
            last = state
        if state == "live":
            if not told:
                if kind == "bg":
                    # daemon の中の背景セッションは、前面の claude を閉じても終わらない（それで待ち続けた事故があった）
                    print(f"{name} ({sid})\nこのセッションは背景（daemon）で動いています。"
                          "前面の claude を閉じても終わりません。"
                          f"idle を確認してから、そのプロセス（pid {pid}）を止めてください。"
                          "止まれば、ここで自動的に再開します。（Ctrl-C で待機をやめる）", flush=True)
                else:
                    print(f"{name} ({sid})\nいま別の場所で動いています (pid {pid})。"
                          "そちらで /exit すると、ここで自動的に再開します。（Ctrl-C で待機をやめる）", flush=True)
                told = True
            while start_time(pid) == start:  # JSON が消えても、プロセスが終わるまでは待つ
                time.sleep(INTERVAL)
            misses = 0
        elif state == "unsure":
            misses = 0
            time.sleep(INTERVAL / 4)
        else:
            misses += 1
            if misses < NEEDED_MISSES:
                time.sleep(INTERVAL / 2)
    return told


def write_json(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data))
    os.replace(tmp, path)


def take_next(path, wait_id):
    """続きの指示を読んで消す（1 回だけ使う）。この claude-wait 宛てで新しいものだけ {"session_id", "cwd", "model"}。"""
    try:
        text = path.read_text()
    except OSError:
        return None
    try:
        path.unlink()
    except OSError:
        pass
    if read_next is None:
        return None
    return read_next(text, os.getpid(), wait_id, time.time())


def main():
    if sys.argv[1:] == ["--version"]:  # 版の表示だけは待たずに返す（シェルにも入らない）
        from version import handle_version
        handle_version(sys.argv[1:], "claude-wait")
        return
    if any(a in ("-h", "--help") for a in sys.argv[1:]):  # 使い方を出して終わる（シェルには入らない）
        print(__doc__.strip())
        return
    argv, rename, model = [], False, None
    it = iter(sys.argv[1:])
    for a in it:
        if a == "--rename":
            rename = True
        elif a == "--model":
            model = next(it, None)
        elif a.startswith("--model="):
            model = a.split("=", 1)[1]
        else:
            argv.append(a)
    if len(argv) != 2 or ("--model" in sys.argv[1:] and not model):
        print("usage: claude-wait <name> <session-id> [--model <model>] [--rename]")
        shell()
    name, sid = argv
    wait_id = sid  # 引数の ID（ロック・.waiter・.next の名前）。sid は開く ID で、続きの指示で変わりうる
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", sid):
        print(f"claude-wait: セッション ID の形が違う: {sid}")
        shell()
    rt = runtime_dir()
    lock = open(rt / f"claude-wait-{sid}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(f"[{name}] 同じセッションを別のペインがすでに待っているか開いている。ここでは開かない。")
        shell()
    sys.stdout.write(f"\033]2;{name} (待機中)\a")
    try:
        if wait_free(name, sid):
            print("終了を確認しました。再開します…", flush=True)
    except KeyboardInterrupt:
        print(f"\n[{name}] 待機をやめました。再開するには: claude-wait {name} {sid}")
        lock.close()
        shell()
    # claude の Ctrl-C で自分が止まらないように、待ち受け側は SIGINT を無視し、子には既定に戻して渡す
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    wdir = rt / "claude-wait"
    waiter, nxt = wdir / f"{wait_id}.waiter", wdir / f"{wait_id}.next"
    try:
        wdir.mkdir(mode=0o700, exist_ok=True)
        try:
            nxt.unlink()  # 前の claude-wait 宛ての残り（pid が違うので使われないが、紛らわしいので消す）
        except FileNotFoundError:
            pass
        write_json(waiter, {"pid": os.getpid(), "start": start_time(os.getpid()), "name": name, "session_id": wait_id})
    except OSError as e:
        print(f"[{name}] 続きの指示の置き場を作れない（restart は使えない）: {e}", flush=True)
    while True:
        if rename:  # resume では -n で名前が変わらないので、手で打ってもらう（-n は害がないので残す）
            print(f"[{name}] 再開したら /rename {name} と打ってください。", flush=True)
        subprocess.run([CLAUDE, "--resume", sid] + (["--model", model] if model else []) + (["-n", name] if rename else []),
                       preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))
        follow = take_next(nxt, wait_id)
        if not follow:
            break
        sid = follow["session_id"]
        print(f"[{name}] 続きの指示で再開します（フォルダ {follow['cwd'] or os.getcwd()}、"
              f"モデル {follow['model'] or model or '既定'}）…", flush=True)
        if follow["cwd"]:
            try:
                os.chdir(follow["cwd"])
            except OSError as e:
                print(f"[{name}] フォルダに移れない（いまのフォルダのまま）: {e}", flush=True)
        model = follow["model"] or model
        # 止めた claude（背景セッションなら daemon の中の host）が確実に終わってから開く。
        # 待っている間は Ctrl-C でやめられるように SIGINT を戻す
        signal.signal(signal.SIGINT, signal.default_int_handler)
        try:
            wait_free(name, sid)
        except KeyboardInterrupt:
            print(f"\n[{name}] 待機をやめました。再開するには: claude-wait {name} {sid}")
            break
        signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        waiter.unlink()
    except OSError:
        pass
    lock.close()  # claude が終わるまでロックを持つ（その間に別の claude-wait が開かないように）
    print(f"[{name}] claude が終了しました。再開するには: claude --resume {sid}")
    shell()


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""kitty の中の Claude Code セッションの名簿を保ち、kitty の再起動や落ちたあとに元へ戻す。

  claude-roster save [--auto]                       いまの名簿を保存する（世代を残す。--auto はタイマー用）
  claude-roster restore [ROLE...] [--from FILE] [--dry-run] [--include-absent] [--include-sleeping] [--force]
                                                    名簿の役割のうち、kitty にいないものを開いて並べ直す
  claude-roster restart ROLE [--model M] [--cwd DIR] 1 人を起動し直す（idle のときだけ。保護するプロセスが動いている間はしない）
  claude-roster sleep ROLE [--force] [--dry-run]    1 人を寝かせる（claude を止めてペインを閉じ、名簿に残す。idle のときだけ）
  claude-roster wake ROLE [--dry-run]               寝かせた役割を開き直し、同じ会話を resume する
  claude-roster status                              名簿といまの差
  claude-roster show                                名簿の中身（1 行 1 人）
  共通: --to SOCKET（kitty を指定）

名簿: $CLAUDE_ROSTER_DIR（既定 $XDG_DATA_HOME/claude-kitty、無ければ ~/.local/share/claude-kitty）/roster.json。
設定: ~/.config/claude-kitty/config.json の view.left / view.guard と roster
  {"roster": {"models": {"dev-a": "opus"}, "ignore": ["scratch"], "generations": 5, "keep_absent_hours": 24}}
send-text は使わない。他のセッションの claude を止めるのは restart と sleep だけ。ペインを閉じるのは sleep だけで、
そのペインの claude（と claude-wait）が終わったのを確かめてから閉じる。
"""
import argparse
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "lib"))
from config import kitten_path, load_roster_config, load_view_config  # noqa: E402
from geometry import tab_pane_fraction  # noqa: E402
from guard import guarded_in_front  # noqa: E402
import proc  # noqa: E402
import roster as R  # noqa: E402
from rundir import live_kitty_sockets, runtime_dir  # noqa: E402
from view import pin_rows  # noqa: E402

ENV = os.environ
KITTEN = kitten_path(ENV)
CLAUDE_HOME = Path(ENV.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")  # Claude Code の設定の置き場（claude-wait と同じ）
SESSIONS = Path(ENV.get("CLAUDE_SESSIONS_DIR") or CLAUDE_HOME / "sessions")
PROJECTS = Path(ENV.get("CLAUDE_PROJECTS_DIR") or CLAUDE_HOME / "projects")
RT = runtime_dir(ENV)  # 記録の置き場（claude-wait と同じ。lib/rundir.py）。kitty の socket は find_sockets で探す


def die(msg, code=1):
    print(f"claude-roster: {msg}", file=sys.stderr)
    sys.exit(code)


def roster_dir():
    if ENV.get("CLAUDE_ROSTER_DIR"):
        return Path(ENV["CLAUDE_ROSTER_DIR"])
    base = Path(ENV["XDG_DATA_HOME"]) if ENV.get("XDG_DATA_HOME") else Path.home() / ".local/share"
    return base / "claude-kitty"


def roster_conf():
    """設定の roster 節（無ければ既定）。壊れていれば止める（別のモデルで開かないように）。"""
    try:
        return load_roster_config(ENV)
    except ValueError as e:
        die(str(e))


# ---- プロセスとセッション ---------------------------------------------------

def start_time(pid):
    """起動時刻（lib/proc.py。Linux は /proc、macOS は sysctl）。Linux 以外で読めなくても生きていれば "alive"
    （claude-wait と同じ決まり。止めた相手がまだいるのを「いない」と取り違えないように）。"""
    if not isinstance(pid, int):
        return None
    s = proc.start_time(pid)
    if s is None and not proc.is_linux() and proc.alive(pid):
        return "alive"
    return s


def ppid_of(pid):
    return proc.ppid(pid) if isinstance(pid, int) else None


def cmdline(pid):
    return proc.argv(pid) or []


_CONFIG_DIRS = []
_PANE_CWD = {}  # kitten @ ls で見たプロセスの cwd（相対パスの CLAUDE_CONFIG_DIR を広げるため）


def config_dir_of(pid):
    """その claude が起動したときの CLAUDE_CONFIG_DIR（既定の置き場・読めないときは None）。"""
    env = proc.environ(pid) if pid else None
    d = (env or {}).get("CLAUDE_CONFIG_DIR")
    if not d or R.has_control(d):
        return None  # 制御文字の入った値は記録しない（名簿が読めなくなる）
    if not d.startswith("/"):
        # direnv の export CLAUDE_CONFIG_DIR=.config など。そのプロセスの cwd から広げる（分からなければ記録しない）
        base = _PANE_CWD.get(pid)
        if not base or not base.startswith("/") or R.has_control(base):
            return None
        d = os.path.normpath(os.path.join(base, d))
    try:
        # 比べる相手は Claude Code の既定の置き場（~/.claude）。claude-roster 自身の CLAUDE_CONFIG_DIR と比べると、
        # direnv が効いたシェルから手で save したとき、そのプロジェクトの役割の config_dir が落ちる
        return None if Path(d).resolve() == (Path.home() / ".claude").resolve() else d
    except OSError:
        return d


def config_dirs():
    """既定の置き場の他に見る設定の置き場（プロジェクトごとに CLAUDE_CONFIG_DIR で分けたもの）。

    direnv の .envrc でプロジェクトごとに置き場を分けていると、セッションの記録（sessions/）と会話の記録（projects/）は
    その置き場にある。見るのは、kitty のペインにいる claude の置き場と名簿に記録した置き場だけ（note_config_dirs）。
    マシンの全部の claude から集めると、関係の無い置き場（macOS では ~/Documents の下など、読むと止まる所）まで読むため。"""
    out = list(_CONFIG_DIRS)
    # claude-roster 自身を direnv の効いたシェルから動かしたとき（SESSIONS が自分の置き場になる）も、既定の置き場を読む
    default = str(Path.home() / ".claude")
    if not ENV.get("CLAUDE_SESSIONS_DIR") and not ENV.get("CLAUDE_PROJECTS_DIR") and default not in out:
        try:
            if CLAUDE_HOME.resolve() != Path(default).resolve():
                out.append(default)
        except OSError:
            pass
    return out


def note_config_dirs(dirs):
    for d in dirs:
        if d and d not in _CONFIG_DIRS:
            _CONFIG_DIRS.append(d)


def note_pane_config_dirs(data):
    """kitten @ ls のペインの前面のプロセスのうち、claude の置き場を覚える。"""
    for osw in data or []:
        for tab in osw.get("tabs", []):
            for w in tab.get("windows", []):
                for p in w.get("foreground_processes") or []:
                    if p.get("pid") and isinstance(p.get("cwd"), str):
                        _PANE_CWD[p["pid"]] = p["cwd"]
                    info = R.parse_argv(p.get("cmdline"))
                    if info and info["tool"] in ("claude", "claude-wait"):
                        note_config_dirs([config_dir_of(p.get("pid"))])


def live_sessions():
    """~/.claude/sessions/*.json（と、ほかの設定の置き場の sessions/）のうち、プロセスが生きているもの
    （procStart で pid の再利用を除く）。"""
    out = []
    files = list(SESSIONS.glob("*.json"))
    for d in config_dirs():
        files += list((Path(d) / "sessions").glob("*.json"))
    for f in files:
        try:
            d = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict):
            continue
        pid = d.get("pid") or (int(f.stem) if f.stem.isdigit() else None)
        st = start_time(pid) if pid else None
        if st is None or not proc.proc_start_matches(d.get("procStart"), st):
            continue  # 終わった、または pid が別のプロセスに再利用されている（procStart と比べるのは Linux だけ）
        d["pid"] = pid
        out.append(d)
    return out


def busy_sessions(sessions):
    """{session_id: 理由}。どこかで claude が開いている、または claude-wait が待っている ID（開くと二重になる）。

    claude-wait のロックは試しに取ると、ちょうど起動した claude-wait を追い返してしまうので、
    プロセスのコマンド行で見る（lib/proc.py）。
    """
    busy = {s["sessionId"]: f"いま動いている (pid {s['pid']})" for s in sessions if s.get("sessionId")}
    me = os.getpid()
    for pid, argv in proc.processes():
        if pid == me:
            continue
        info = R.parse_argv(argv)
        if info and info.get("session_id") and info["session_id"] not in busy:
            what = "claude-wait が待っている" if info["tool"] == "claude-wait" else "claude が開いている"
            busy[info["session_id"]] = f"{what} (pid {pid})"
    return busy


def settings_model(cwd):
    return R.settings_model(cwd, lambda p: Path(p).read_text())


def transcript_model(sid):
    """会話記録の末尾から、最後の assistant の model。大きいので後ろから読む。"""
    try:
        files = list(PROJECTS.glob(f"*/{sid}.jsonl"))
        for d in config_dirs():
            files += list((Path(d) / "projects").glob(f"*/{sid}.jsonl"))
    except OSError:
        return None
    files = [f for f in files if f.is_file()]
    if not files:
        return None
    f = max(files, key=lambda x: x.stat().st_mtime)
    size = f.stat().st_size
    for span in (256 * 1024, 4 * 1024 * 1024):
        with open(f, "rb") as fh:
            fh.seek(max(0, size - span))
            data = fh.read()
        lines = data.decode(errors="replace").splitlines()
        if size > span:
            lines = lines[1:]  # 途中から読んだ最初の行は切れている
        m = R.transcript_model(lines)
        if m or size <= span:
            return m
    return None


# ---- kitty ------------------------------------------------------------------

def kitten(sock, *args, check=True):
    r = subprocess.run([KITTEN, "@", "--to", sock, *args], capture_output=True, text=True, timeout=10)
    if check and r.returncode:
        die(f"kitten @ {' '.join(args[:2])} に失敗: {r.stderr.strip()}")
    return r


def ls(sock):
    r = kitten(sock, "ls", check=False)
    if r.returncode:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def roles_in(osw_list):
    return {(w.get("user_vars") or {}).get("role") for osw in osw_list for t in osw.get("tabs", [])
            for w in t.get("windows", [])} - {None}


def kitties():
    """動いている kitty の [(socket, ls)]。"""
    out = []
    for sock in live_kitty_sockets(ENV):  # $XDG_RUNTIME_DIR か /tmp の kitty-<pid> で、kitty が生きているもの
        data = ls(sock)
        if data is not None:
            out.append((sock, data))
    return out


def find_kitty(arg, left, known_roles=()):
    """(socket, ls) か (None, None)。統括のいる kitty、いなければ名簿の役割がいちばん多い kitty。"""
    if arg:
        data = ls(arg)
        if data is None:
            die(f"{arg} の kitty に繋がらない")
        return arg, data
    ks = kitties()
    # 試験用の kitty（別のクラス）が同じ役割名で動いていることがあるので、claude-kitty のクラスの窓を優先する
    cls = ENV.get("CLAUDE_KITTY_CLASS") or "kitty-claude"
    mine = [k for k in ks if any(o.get("wm_class") == cls for o in k[1])]
    ks = mine or ks
    hits = [k for k in ks if left in roles_in(k[1])]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"{left} のいる kitty が 2 つある（--to で指定する）")
    known = set(known_roles)
    scored = sorted(((len(known & roles_in(d)), s, d) for s, d in ks), key=lambda x: -x[0])
    if scored and scored[0][0] > 0:
        if len(scored) > 1 and scored[1][0] == scored[0][0]:
            die("名簿の役割のいる kitty を 1 つに決められない（--to で指定する）")
        return scored[0][1], scored[0][2]
    return None, None


# ---- 名簿の読み書き -------------------------------------------------------------

def roster_lock(block=True):
    d = roster_dir()
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    fh = open(d / ".lock", "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except OSError:
        fh.close()
        return None
    return fh


def load_roster(path=None, set_aside=False):
    """名簿を読む。set_aside（保存のとき）なら、読めない名簿を roster.json.bad へ退けて None を返す
    （壊れた名簿のせいで自動保存が永久に止まらないように。退けたものは手で調べられる）。"""
    path = Path(path) if path else roster_dir() / "roster.json"
    try:
        rost = R.check_roster(json.loads(path.read_text()))
        note_config_dirs(e.get("config_dir") for e in rost["sessions"].values())
        return rost
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        if not set_aside:
            die(f"名簿を読めない: {path}: {e}（claude-roster show --from {path}.1 で前の世代を見る）")
        bad = path.with_name(path.name + ".bad")
        os.replace(path, bad)
        print(f"claude-roster: 読めない名簿を {bad} へ退けた: {e}", file=sys.stderr)
        return None


def write_roster(data, generations):
    """roster.json に書く。中身が前と意味のある違いがあれば、前のものを roster.json.1 … へ回す。"""
    d = roster_dir()
    cur = d / "roster.json"
    old = None
    try:
        old = json.loads(cur.read_text())
    except (OSError, ValueError):
        pass
    changed = R.signature(old) != R.signature(data)
    if changed and old is not None:
        for i in range(generations - 1, 0, -1):
            src = cur if i == 1 else d / f"roster.json.{i - 1}"
            if src.exists():
                os.replace(src, d / f"roster.json.{i}")
    tmp = d / f".roster.json.{os.getpid()}.tmp"
    # セッション ID とフォルダが入るので本人だけ（作るときから 0600）
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, ensure_ascii=False, indent=1))
    os.replace(tmp, cur)
    return changed


def current_roster(sock, data, left, conf):
    try:
        return _current_roster(data, left, conf)
    except (KeyError, ValueError) as e:  # splits 以外の配置（stack でズーム中など）で位置が取れないとき
        die(f"ペインの配置を読めない（splits でないタブがあるかもしれない）: {e}")


def _current_roster(data, left, conf):
    note_pane_config_dirs(data)
    return R.build_roster(data, live_sessions(), left, tab_pane_fraction, conf["models"], settings_model,
                          transcript_model, now=time.time(), ignore=set(conf["ignore"]), config_dir_fn=config_dir_of)


def show(rost):
    for t in rost["tabs"]:
        shape = f"  段組み {R.rows_spec(t['rows'])}" if "rows" in t else ""
        print(f"[{t['title']}] {', '.join(t['roles'])}{shape}")
    for role, e in rost["sessions"].items():
        sid = (e.get("session_id") or "-")[:8]
        extra = " 引き継ぎ" if e.get("carried") else ""
        extra += " （ペイン無し）" if e.get("absent_since") else ""
        extra += f" {R.sleep_label(e)}" if e.get("sleeping") else ""
        print(f"  {role}: {sid} {e.get('state')} {e.get('kind') or '-'} model={e.get('model') or '-'}"
              f"({e.get('model_source') or '-'}) {e.get('cwd')}{extra}")


# ---- コマンド ---------------------------------------------------------------

def cmd_save(args, view, conf):
    lock = roster_lock(block=not args.auto)
    if lock is None:
        print("claude-roster: 復元か保存の最中なので、今回は保存しない", file=sys.stderr)
        return 0
    old = load_roster(set_aside=True)
    sock, data = find_kitty(args.to, view["left"], (old or {}).get("sessions", {}).keys())
    if sock is None:
        # kitty が落ちた直後に空の名簿で上書きしない（戻すための名簿が消えてしまう）
        print("claude-roster: 対象の kitty が無いので保存しない（前の名簿を残す）", file=sys.stderr)
        return 0 if args.auto else 1
    new = current_roster(sock, data, view["left"], conf)
    if not new["sessions"]:
        print("claude-roster: 役割のあるペインが無いので保存しない", file=sys.stderr)
        return 0 if args.auto else 1
    if args.auto and old and view["left"] in old["sessions"] and view["left"] not in new["sessions"]:
        # 統括のペインが無いときに書くと、統括と段組みが名簿から消える（戻すと配置が崩れる）。手の save で確定する
        print(f"claude-roster: 統括 {view['left']} のペインが無いので自動では保存しない（claude-roster save で確定）",
              file=sys.stderr)
        return 0
    new["socket"] = sock
    new = R.carry_over(new, old, new["saved_at"], conf["keep_absent_hours"] * 3600, drop_absent=not args.auto)
    try:
        R.check_roster(json.loads(json.dumps(new)))  # 読めない名簿は書かない（次の保存で退けられ、引き継ぎが消えるので）
    except ValueError as e:
        die(f"作った名簿がおかしいので書かない（前の名簿のまま）: {e}")
    changed = write_roster(new, conf["generations"])
    if not args.auto:
        show(new)
        print(f"保存した: {roster_dir() / 'roster.json'}{'（前と同じ中身）' if not changed else ''}")
        if new.get("skipped"):
            print("入れなかった役割（名前に区切り文字がある・重複）: " + ", ".join(new["skipped"]))
    return 0


def wait_for_kitty(left, roles, before, timeout=20.0):
    """新しく起動した kitty の socket を待つ。"""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for sock, data in kitties():
            if sock in before:
                continue
            have = roles_in(data)
            if left in have or set(roles) & have:
                return sock
        time.sleep(0.5)
    return None


def run_view(sock, left, rows, dry):
    """claude-view rows で並べ直す。rows が None なら claude-view equalize（いまの並びのまま）。"""
    sub = ["equalize"] if rows is None else ["rows", R.rows_spec(rows)]
    shown = " ".join(sub[:1] + [repr(x) for x in sub[1:]])
    cmd = [str(HERE / "bin/claude-view"), "--to", sock, "--left", left] + (["--dry-run"] if dry else []) + sub
    print("並べ直す: claude-view " + shown)
    r = subprocess.run(cmd)
    if r.returncode == 2:
        print("claude-roster: 保護する窓が前面なので並べ直さなかった。あとで claude-view " + shown, file=sys.stderr)
    return r.returncode


def cmd_restore(args, view, conf):
    rost = load_roster(args.source)
    if rost is None:
        die("名簿が無い（先に claude-roster save）")
    return restore(args, view, conf, rost)[0]


def restore(args, view, conf, rost):
    """名簿 rost から開く。(終了コード, 開いた役割, 開かなかった役割と理由) を返す（wake も使う）。"""
    left = rost["left"]
    if not args.dry_run and not args.force and guarded_in_front(view["guard"]):
        die("保護する窓（view.guard）が前面にあるので開かない（--force で実行）", 2)
    lock = roster_lock()  # 途中で自動保存が半端な名簿を書かないように
    sock, data = find_kitty(args.to, left, rost["sessions"].keys())
    present = roles_in(data) if data else set()
    note_config_dirs(e.get("config_dir") for e in rost["sessions"].values())
    note_pane_config_dirs(data)
    busy = busy_sessions(live_sessions())
    for entry in rost["sessions"].values():  # 設定の roster.claude（フォルダ → 包み）は開くときの設定で決める
        cmd = R.claude_for(entry.get("cwd"), conf.get("claude"))
        if cmd:
            entry["claude"] = cmd
        else:
            entry.pop("claude", None)
    try:
        launch, skipped = R.plan_restore(rost, present, busy, only=args.roles, include_absent=args.include_absent,
                                         include_sleeping=args.include_sleeping)
    except ValueError as e:
        die(str(e))
    for role, why in skipped:
        print(f"開かない: {role}: {why}")
    if any("いま動いている" in why for _, why in skipped):
        print("（kitty が落ちた直後なら、claude の後片付けが終わっていないだけかもしれない。数秒後にもう一度 restore する）")
    wait_cmd = ENV.get("CLAUDE_ROSTER_WAIT_CMD") or str(HERE / "bin/claude-wait")
    main = next((t for t in rost["tabs"] if "rows" in t), None)
    if sock is None:
        if not args.dry_run and not args.force and guard_running(view["guard"]):
            # 新しい kitty の窓は最大化して出るので、保護するアプリが背面で動いているだけでも開かない
            die("保護するプロセス（view.guard。全画面のアプリなど）が動いているので kitty を起動しない（--force で実行）", 2)
        if left not in launch:
            print(f"注意: 統括 {left} を開かないので、並べ直しはしない")
        text = R.session_file(rost, launch, wait_cmd, header=f"claude-roster restore（名簿 {time.strftime('%F %T', time.localtime(rost['saved_at']))}）",
                              pinned=view["pinned"])
        if text is None:
            print("開くものが無い")
            return 0, launch, skipped
        sdir = RT / "claude-roster"
        sdir.mkdir(mode=0o700, exist_ok=True)
        sfile = sdir / f"restore-{int(time.time())}.session"
        sfile.write_text(text)
        print(f"kitty が無いので、セッションファイルから起動する: {sfile}")
        if args.dry_run:
            print(text, end="")
            return 0, launch, skipped
        before = {s for s, _ in kitties()}
        launcher = ENV.get("CLAUDE_ROSTER_LAUNCHER") or str(HERE / "bin/claude-kitty")
        subprocess.run([launcher, str(sfile)], check=False)
        sock = wait_for_kitty(left, launch, before)
        if sock is None:
            die("起動した kitty が見つからない（20 秒待った）")
        print(f"起動した: {sock}")
        rows = R.filter_rows(main.get("rows") if main else [], set(launch))
        # 常時表示（view.pinned）は名簿の段組みに無くても前に出す（claude-view rows が 1 段目の先頭に置く）
        # 統括のタブ（段組み）が名簿に無ければ、セッションファイルも pinned を前に置いていないので並べ直さない
        if main:
            rows = pin_rows(rows, [p for p in view["pinned"] if p in launch and p != left])
        if left in launch and main and rows:
            time.sleep(1.0)
            run_view(sock, left, rows, False)
        lock.close()
        return 0, launch, skipped
    # kitty は動いている: 欠けた分だけ足す
    if not launch:
        print("欠けている役割は無い")
        return 0, launch, skipped
    tabs = {t["title"] for osw in data for t in osw.get("tabs", [])}
    # 並べ直しが走るとき（統括とそのタブがあるとき）だけ、常時表示（view.pinned）を standby に入れて前に出す。
    # 走らないのに standby へ入れると、名簿のタブにも出ず見えなくなる
    rearrange = bool((left in present or left in launch) and main)
    pins = [p for p in view["pinned"] if p != left] if rearrange else []
    for role in launch:
        # 統括は名簿の統括のタブ（無ければ新しいタブ）へ。ほかは standby に入れて claude-view rows で前に出す
        title = (main["title"] or "main") if role == left and main else R.target_tab(rost, role, pins)
        a = R.launch_args(role, rost["sessions"][role], wait_cmd, title, title in tabs)
        print("足す: " + role + (f"（タブ {title}）"))
        if args.dry_run:
            print("  kitten @ " + " ".join(a))
            continue
        kitten(sock, *a)
        tabs.add(title)
    if rearrange and any(r in launch for row in main.get("rows", []) for r in row):
        rows = pin_rows(R.filter_rows(main["rows"], present | set(launch)), [p for p in pins if p in present | set(launch)])
        if not args.dry_run:
            time.sleep(0.5)
        run_view(sock, left, rows, args.dry_run)
    elif rearrange and any(p in launch for p in pins):
        # 足したのが常時表示だけなら、名簿の段組みに戻さず（保存のあとに手で並べた形を崩さない）、
        # いまの並びのまま claude-view が pinned を 1 段目の先頭に置く
        if not args.dry_run:
            time.sleep(0.5)
        run_view(sock, left, None, args.dry_run)
    lock.close()
    return 0, launch, skipped


def guard_running(patterns):
    for pat in patterns:
        r = subprocess.run(["pgrep", "-f", "--", pat], capture_output=True, text=True)
        if r.returncode > 1:
            die(f"view.guard の {pat!r} で pgrep が失敗: {r.stderr.strip()}")
        if r.stdout.split():
            return True
    return False


def state_word(sid):
    try:
        r = subprocess.run([str(HERE / "bin/claude-state"), "get", sid], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def read_waiter(sid):
    try:
        d = json.loads((RT / "claude-wait" / f"{sid}.waiter").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(d, dict) or not isinstance(d.get("pid"), int):
        return None
    if start_time(d["pid"]) != d.get("start"):
        return None  # その claude-wait はもういない（pid の再利用も除く）
    return d


def find_pane(data, role):
    for osw in data:
        for t in osw.get("tabs", []):
            for w in t.get("windows", []):
                if (w.get("user_vars") or {}).get("role") == role:
                    return w
    return None


def cmd_restart(args, view, conf):
    rost = load_roster()
    entry = (rost or {}).get("sessions", {}).get(args.role) or {}
    if guard_running(view["guard"]):
        die("保護するプロセス（view.guard。全画面のアプリなど）が動いているので止めない", 2)
    sock, data = find_kitty(args.to, view["left"], (rost or {}).get("sessions", {}).keys())
    note_pane_config_dirs(data)  # まだ名簿に無いプロジェクトのペインでも、その置き場のセッションを読めるように
    if sock is None:
        die("対象の kitty が無い（claude-roster restore）")
    sessions = live_sessions()
    by_pid = {s["pid"]: s for s in sessions}
    by_sid = {s.get("sessionId"): s for s in sessions}
    win = find_pane(data, args.role)
    pane = R.pane_session(win, by_pid, by_sid) if win else None
    sj = (pane or {}).get("session")
    if pane and sj is None and pane.get("session_id"):
        sj = by_sid.get(pane["session_id"])
    sid = (pane or {}).get("session_id")
    wait_id = (pane or {}).get("wait_id")  # claude-wait の引数の ID（/clear のあとは sid と違う）
    waiter = read_waiter(wait_id) if wait_id else None
    # 前面の claude の親が、その claude-wait であること（止めたあとに続きを開けるのはそれだけ）
    if pane and pane.get("front_pid") and waiter and ppid_of(pane["front_pid"]) != waiter["pid"]:
        waiter = None
    why = R.restart_refusal(args.role, pane, sj, state_word(sid) if sid else "", False, waiter)
    if why:
        die(why, 3)
    target = R.stop_target(pane, sj, sessions, allow_bg=args.allow_bg)
    if not target:
        die("止める pid を決められない（背景セッションは --allow-bg を付けたときだけ。host を他と共有していれば止めない）", 3)
    # 名簿の値は、名簿のセッションがいまのセッションと同じときだけ使う（保存のあとに入れ替わっていれば、いまの値）
    same = entry.get("session_id") == sid
    cwd = args.cwd or (entry.get("cwd") if same else None) or sj.get("cwd")
    if cwd and not Path(cwd).is_dir():
        die(f"フォルダが無い: {cwd}")
    model = args.model or (entry.get("model") if same else None) or pane.get("argv_model")
    print(f"{args.role}: {sid[:8]} を止めて、{cwd} / モデル {model or '既定'} で開き直す（pid {target}"
          f"{'、背景セッションの host' if sj.get('kind') == 'bg' else ''}）")
    if args.dry_run:
        return 0
    nxt = RT / "claude-wait" / f"{wait_id}.next"
    tmp = nxt.with_name(f".{nxt.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(R.next_payload(waiter["pid"], wait_id, sid, cwd, model, time.time())))
    os.replace(tmp, nxt)
    # 止める直前にもう一度: 同じプロセスのまま idle か（確認してから送るまでの間に動き出していないか）
    st = start_time(target)
    again = next((s for s in live_sessions() if s.get("sessionId") == sid), None)
    word = state_word(sid)
    if (st is None or not again or again.get("status") != "idle" or (word and word not in ("idle", "done"))
            or guard_running(view["guard"])):
        nxt.unlink(missing_ok=True)
        die("止める直前に状態が変わったのでやめた", 3)
    os.kill(target, signal.SIGTERM)
    front = pane.get("front_pid")
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline and start_time(target) == st:
        time.sleep(0.3)
    if start_time(target) == st:
        # 後で人が /exit したときに勝手に開き直さないよう、続きの指示は消す
        nxt.unlink(missing_ok=True)
        print(f"claude-roster: {args.timeout:.0f} 秒で止まらなかった（続きの指示は消した。止まればシェルに戻る）", file=sys.stderr)
        return 1
    if sj.get("kind") == "bg" and front and front != target and start_time(front):
        # 背景セッションの前面は host が止まれば終わるはず。残っていれば前面も止める（claude-wait が続きを開く）
        time.sleep(3)
        if start_time(front) and ppid_of(front) == waiter["pid"]:
            os.kill(front, signal.SIGTERM)
    while time.monotonic() < deadline + 30:
        s = next((s for s in live_sessions() if s.get("sessionId") == sid), None)
        if s and s["pid"] != target:
            print(f"開き直した: pid {s['pid']}（/rename {args.role} が要るかもしれない）")
            return 0
        time.sleep(0.5)
    print("claude-roster: 止めたが、まだ開き直したのを確認できない（ペインを見る）", file=sys.stderr)
    return 1


def pane_by_id(data, wid):
    for osw in data or []:
        for t in osw.get("tabs", []):
            for w in t.get("windows", []):
                if w.get("id") == wid:
                    return w
    return None


def sid_live(sid):
    return any(s.get("sessionId") == sid for s in live_sessions())


def cmd_sleep(args, view, conf):
    left, role = view["left"], args.role
    if role == left or role in view["pinned"]:
        die(R.sleep_refusal(role, left, view["pinned"], None, None, None, ""), 3)
    if guard_running(view["guard"]):
        if not args.dry_run:
            die("保護するプロセス（view.guard。全画面のアプリなど）が動いているので止めない", 2)
        print("注意: 保護するプロセス（view.guard）が動いているので、--dry-run でなければ止めない")
    lock = roster_lock()  # 寝かせ終わるまで自動の保存に半端な名簿を書かせない
    old = load_roster()
    sock, data = find_kitty(args.to, left, (old or {}).get("sessions", {}).keys())
    note_pane_config_dirs(data)
    win = find_pane(data, role) if data else None
    now = time.time()
    sessions = live_sessions()
    by_pid = {s["pid"]: s for s in sessions}
    by_sid = {s.get("sessionId"): s for s in sessions}
    cur = current_roster(sock, data, left, conf) if data else None
    if cur and cur["sessions"] and (left in cur["sessions"] or not old or left not in old["sessions"]):
        # いまの kitty から作った名簿に、前の名簿の引き継ぎ（absent・寝ている役割）を足したものを土台にする
        base = R.carry_over(cur, old, now, conf["keep_absent_hours"] * 3600)
        base["socket"] = sock
    elif win:
        # 統括のペインが無いときに書くと、統括と段組みが名簿から消える（自動の保存と同じ理由）
        die(f"統括 {left} のペインが無いので寝かせない（claude-roster save で確定してから）", 3)
    elif old is None:
        die("名簿が無く、kitty にもその役割がいない")
    else:
        base = json.loads(json.dumps(old))  # kitty が無い: 名簿に印を付けるだけ
    pane = R.pane_session(win, by_pid, by_sid) if win else None
    if not win and role not in base["sessions"] and old and role in old["sessions"]:
        base["sessions"][role] = dict(old["sessions"][role])  # keep_absent_hours を過ぎて引き継がれなかった
    entry = base["sessions"].get(role)
    sj = (pane or {}).get("session")
    if pane and sj is None and pane.get("session_id"):
        sj = by_sid.get(pane["session_id"])
    sid = (pane or {}).get("session_id")
    why = R.sleep_refusal(role, left, view["pinned"], entry, pane, sj,
                          state_word(sid) if sid and not args.force else "", force=args.force)
    if why:
        die(why, 3)
    if pane is None:
        # ペインはもう無い: 名簿に印を付けるだけ（その ID がどこかで開いていれば、寝ているとは言えないので断る）
        busy = busy_sessions(sessions)
        if entry["session_id"] in busy:
            die(f"{role} の {entry['session_id'][:8]} は{busy[entry['session_id']]}（寝かせない）", 3)
        print(f"{role}: ペインが無いので、名簿に寝ている印だけ付ける（{entry['session_id'][:8]}、{entry.get('cwd')}）")
        if args.dry_run:
            return 0
        write_roster(R.mark_sleeping(base, role, entry, now), conf["generations"])
        print(f"寝かせた: {role}（claude-roster wake {role} で起こす）")
        return 0
    target = R.stop_target(pane, sj, sessions, allow_bg=args.allow_bg)
    if not target:
        die("止める pid を決められない（背景セッションは --allow-bg を付けたときだけ。host を他と共有していれば止めない）", 3)
    wait_id = pane.get("wait_id")
    waiter = read_waiter(wait_id) if wait_id else None
    if waiter and (not pane.get("waiter_pid") or waiter["pid"] != pane["waiter_pid"]
                   or (pane.get("front_pid") and ppid_of(pane["front_pid"]) != waiter["pid"])):
        waiter = None  # そのペインの claude を開いた claude-wait ではない
    wid = win.get("id")
    how = ("claude-wait にシェルへ戻らず終わるよう伝える" if waiter
           else "claude-wait の続きの指示が使えないので、claude が終わってシェルに戻ったあとペインを閉じる")
    print(f"{role}: {sid[:8]} を止めてペイン（window {wid}）を閉じ、名簿に寝かせる（{entry.get('cwd')} / "
          f"モデル {entry.get('model') or '既定'}）。{how}")
    if args.dry_run:
        print(f"  kill -TERM {target}")
        print(f"  kitten @ close-window --match id:{wid} --ignore-no-match（claude が終わったのを確かめてから）")
        return 0
    nxt = RT / "claude-wait" / f"{wait_id}.next" if waiter else None
    if nxt:
        tmp = nxt.with_name(f".{nxt.name}.{os.getpid()}.tmp")
        tmp.write_text(json.dumps(R.exit_payload(waiter["pid"], wait_id, time.time())))
        os.replace(tmp, nxt)
    # 止める直前にもう一度: 同じプロセスのまま idle か（--force なら idle は見ない）
    st = start_time(target)
    front = pane.get("front_pid")
    front_st = start_time(front) if front and front != target else None  # 背景セッションの前面を、あとで同じか比べる
    again = next((s for s in live_sessions() if s.get("sessionId") == sid), None)
    word = "" if args.force else state_word(sid)
    if (st is None or not again or guard_running(view["guard"])
            or (not args.force and (again.get("status") != "idle" or (word and word not in ("idle", "done"))))):
        if nxt:
            nxt.unlink(missing_ok=True)
        die("止める直前に状態が変わったのでやめた", 3)
    os.kill(target, signal.SIGTERM)
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline and start_time(target) == st:
        time.sleep(0.3)
    if start_time(target) == st:
        if nxt:
            nxt.unlink(missing_ok=True)  # 後で人が /exit したときに勝手に終わらない（シェルに戻る）ように
        if start_time(target) == st:  # 消す間に終わっていれば（指示を読んだかもしれない）、そのまま続ける
            print(f"claude-roster: {args.timeout:.0f} 秒で止まらなかったので、ペインは閉じない（名簿も変えない）",
                  file=sys.stderr)
            return 1
    if sj.get("kind") == "bg" and front_st is not None and start_time(front):
        time.sleep(3)
        if R.bg_front_stoppable(front_st, start_time(front), ppid_of(front), waiter["pid"] if waiter else None):
            os.kill(front, signal.SIGTERM)
    # 閉じる前に: そのセッションの claude がどこにもいないこと、ペインの前面にシェルしか残っていないこと
    closed, closable, ls_failed, unreadable = False, False, False, False
    while time.monotonic() < deadline + min(10.0, args.timeout):
        now_ls = ls(sock)
        ls_failed = now_ls is None  # ls に失敗したときを「閉じた」と取り違えない
        if not ls_failed:
            w2 = pane_by_id(now_ls, wid)
            closed = closed or w2 is None  # claude-wait が終わってペインが自分で閉じた（window id は使い回されない）
            closable = closed or R.pane_closable(w2)
            unreadable = not closed and not (w2 or {}).get("foreground_processes")
        if closable and not sid_live(sid):
            break
        time.sleep(0.3)
    else:
        if nxt:
            nxt.unlink(missing_ok=True)
        if not closed and ls_failed:
            print(f"claude-roster: claude は止めたが、kitten @ ls に失敗し続けてペインの中を確かめられないので閉じない"
                  f"（名簿も変えない。確認して閉じてから claude-roster sleep {role} で印を付ける）", file=sys.stderr)
            return 1
        if not closed and unreadable:
            print(f"claude-roster: claude は止めたが、ペインの前面のプロセスが読めない（空）ので閉じない"
                  f"（名簿も変えない。確認して閉じてから claude-roster sleep {role} で印を付ける）", file=sys.stderr)
            return 1
        if not closed:
            print(f"claude-roster: claude は止めたが、ペインに claude か claude-wait かシェル以外が残っているので閉じない"
                  f"（名簿も変えない。確認して閉じてから claude-roster sleep {role} で印を付ける）", file=sys.stderr)
            return 1
        # ペインはもう無い: 戻せるように印は付ける（その ID がまだどこかで動いていれば、wake は二重に開かない）
        print(f"claude-roster: ペインは閉じたが、{sid[:8]} がまだどこかで動いている（印は付ける）", file=sys.stderr)
    if not closed:
        kitten(sock, "close-window", "--match", f"id:{wid}", "--ignore-no-match")
        time.sleep(0.3)
        after = ls(sock)
        if after is None or pane_by_id(after, wid) is not None:
            # ペインが残ると次の保存で印が外れるので、ここでは書かない（閉じたあとの sleep は印を付けるだけ）
            why = "閉じたか ls で確かめられなかった" if after is None else "閉じなかった"
            print(f"claude-roster: ペイン（window {wid}）が{why}（名簿は変えない。閉じたのを確かめてから "
                  f"claude-roster sleep {role} で印を付ける）", file=sys.stderr)
            return 1
    was_main = any(role in t["roles"] and "rows" in t for t in base["tabs"])
    write_roster(R.mark_sleeping(base, role, entry, time.time()), conf["generations"])
    print(f"寝かせた: {role}（{sid[:8]}。claude-roster wake {role} で起こす）")
    if was_main and find_pane(ls(sock) or [], left):
        run_view(sock, left, None, False)  # 閉じたペインの分を等分割に戻す
    return 0


def cmd_wake(args, view, conf):
    rost = load_roster()
    if rost is None:
        die("名簿が無い（先に claude-roster save）")
    e = rost["sessions"].get(args.role)
    if e is None:
        die(f"名簿に無い役割: {args.role}")
    if not e.get("sleeping"):
        die(f"{args.role} は寝ていない（ペインが無いなら claude-roster restore {args.role} で開く）")
    print(f"{args.role}: {R.sleep_label(e)}。{(e.get('session_id') or '-')[:8]} を {e.get('cwd')} で開き直す")
    # 寝かせる前に統括のタブの段組みにいたなら、その位置に戻した名簿で開く（restore で 1 人を開くのと同じ決まり）
    awake = R.mark_awake(json.loads(json.dumps(rost)), args.role)
    ns = argparse.Namespace(roles=[args.role], source=None, dry_run=args.dry_run, include_absent=False,
                            include_sleeping=True, force=args.force, to=args.to)
    rc, launch, skipped = restore(ns, view, conf, awake)
    if rc or args.dry_run or args.role in {r for r, _ in skipped}:
        return rc or (0 if args.dry_run else 1)
    lock = roster_lock()
    latest = load_roster()
    if latest and (latest["sessions"].get(args.role) or {}).get("sleeping"):
        write_roster(R.mark_awake(latest, args.role), conf["generations"])
    lock.close()
    print(f"起こした: {args.role}" if args.role in launch else f"{args.role} はもう kitty にいる（寝ている印を外した）")
    return 0


def cmd_status(args, view, conf):
    rost = load_roster()
    if rost is None:
        die("名簿が無い（先に claude-roster save）")
    sock, data = find_kitty(args.to, rost["left"], rost["sessions"].keys())
    now_r = current_roster(sock, data, rost["left"], conf) if sock else None
    age = time.time() - rost["saved_at"]
    print(f"名簿: {time.strftime('%F %T', time.localtime(rost['saved_at']))}（{age / 60:.0f} 分前）"
          f"、kitty: {sock or '無し'}")
    lines = R.diff_lines(rost, now_r)
    for line in lines or ["差なし"]:
        print(line)
    # 終わらない待ちのループが背景に残ると status が "shell" のままになり、restart が断る。その元を見せる（止めない）
    try:
        import bgshell
        kids = bgshell.child_map()
        for line in R.shell_lines(R.session_pids(rost, now_r, live_sessions()),
                                  lambda pid: bgshell.long_shells(pid, kids=kids), bgshell.line):
            print(line)
    except Exception as e:  # noqa: BLE001  見せるだけの行なので、読めなくても status は出す
        print(f"背景のシェル: 調べられなかった（{type(e).__name__}: {e}）")
    return 0


def main(argv=None):
    if (sys.argv[1:] if argv is None else argv) == ["--version"]:  # 版の表示だけは設定や kitty を読まずに返す
        from version import handle_version
        handle_version((sys.argv[1:] if argv is None else argv), "claude-roster")
        return 0
    sys.stdout.reconfigure(line_buffering=True)  # 子の claude-view の出力と順番が入れ替わらないように
    try:
        view = load_view_config(ENV)
    except ValueError as e:
        die(str(e))
    conf = roster_conf()
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--to", help="kitty の socket（unix:/run/user/…/kitty-<pid>）")
    ap = argparse.ArgumentParser(prog="claude-roster")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("save", parents=[common]); p.add_argument("--auto", action="store_true")
    p = sub.add_parser("restore", parents=[common]); p.add_argument("roles", nargs="*")
    p.add_argument("--from", dest="source"); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--include-absent", action="store_true"); p.add_argument("--force", action="store_true")
    p.add_argument("--include-sleeping", action="store_true", help="寝かせた役割も開く")
    p = sub.add_parser("restart", parents=[common]); p.add_argument("role"); p.add_argument("--model"); p.add_argument("--cwd")
    p.add_argument("--timeout", type=float, default=30.0); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--allow-bg", action="store_true", help="背景セッション（kind=bg）も止める（実物では確認していない）")
    p = sub.add_parser("sleep", parents=[common]); p.add_argument("role")
    p.add_argument("--force", action="store_true", help="idle の確認を省く")
    p.add_argument("--timeout", type=float, default=30.0); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--allow-bg", action="store_true", help="背景セッション（kind=bg）も止める（実物では確認していない）")
    p = sub.add_parser("wake", parents=[common]); p.add_argument("role"); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true", help="保護する窓が前面でも開く（restore と同じ）")
    sub.add_parser("status", parents=[common])
    p = sub.add_parser("show"); p.add_argument("--from", dest="source")
    args = ap.parse_args(argv)
    if args.cmd == "show":
        rost = load_roster(args.source)
        if rost is None:
            die("名簿が無い")
        show(rost)
        return 0
    return {"save": cmd_save, "restore": cmd_restore, "restart": cmd_restart, "status": cmd_status,
            "sleep": cmd_sleep, "wake": cmd_wake}[args.cmd](args, view, conf)


if __name__ == "__main__":
    sys.exit(main())

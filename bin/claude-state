#!/usr/bin/env python3
"""Claude Code のセッションの状態（working / waiting / done / idle）を、kitty のペインの背景色で見せる。

  claude-state hook EVENT        Claude Code の hook から呼ぶ（stdin に hook の JSON）。決して失敗しない
  claude-state waiting           「ふつうの文で問いを残した」と手で付ける（次の入力で working に戻る）
  claude-state get [SESSION_ID]  状態を 1 語で出す（記録が無ければ空）
  claude-state paint SESSION_ID TEXT   TEXT を状態の色で出す（ステータス行用）
  claude-state list [--json] [--all]   統括用。1 行 1 セッションで role・状態・続いている時間
  claude-state marks [--clear]   standby などのタブの題の「●」を付け直す（--clear は全部外す）
  claude-state subagents [SESSION_ID]  ステータス行用。「サブ: 動作 N ／ 終了済み M（最古 X日）」（どちらも 0 なら何も出さない）
  claude-state repaint [--to SOCKET]   記録から全ペインの背景を塗り直す（kitty が設定を読み直すと色が消えるため）
  claude-state watch [--to SOCKET]... [--interval 1]   常駐。done のペインを見たら idle に戻す（systemd のユーザーサービスで動かす）

目立たせるのは waiting だけ（背景を少し暖色に、ステータス行の名前をオレンジに）。working はごく少し青み、
done（終わって、まだ見ていない）はごく薄い緑、idle は元の色（kitty.conf の background）。
done → idle は `claude-state watch`（kitty の外の常駐。lib/statewatch.py）と、kitty の watcher
（kitty/claude_state_watcher.py。設定を読み直す前からあるペインには付かない）が、ペインにフォーカスが来て続いたときに行う。
フォーカスは動かさない。kitty の外では何もしない。
使う kitten @ は ls・set-colors・set-tab-title だけ（close 系と send-text は使わない）。watch は ls と get-colors を
kitty の socket で直接読む（毎秒 kitten を起こさないため）。
"""
import json
import os
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "lib"))
from config import kitten_path, load_state_config  # noqa: E402
from kstate import (Kitten, all_states, alive, load, refresh_marks, save, session_lock, state_dir,  # noqa: E402
                    state_file, state_lock, turn_origin)
from state import (DEFAULT_BASE, background_for, claude_pid, find_window, format_list, list_rows,  # noqa: E402
                   is_notice, merge_colors, merge_notice, merge_subagent_colors, nested_claude, paint, subagent_summary, parse_hook_input, repaint_ops, transition, valid_session_id,
                   viewing)

KITTEN_TIMEOUT = 2.0


def conf(env):
    try:
        return load_state_config(env)
    except ValueError as e:
        print(f"claude-state: {e}（既定の色を使う）", file=sys.stderr)
        return {"colors": merge_colors(None), "notice": merge_notice(None), "base": DEFAULT_BASE, "done_dwell": 2.0,
                "watch_sockets": None,
                "subagent_colors": merge_subagent_colors(None),
                "left": env.get("CLAUDE_VIEW_LEFT") or "main"}


def ancestors(limit=12):
    """[(pid, argv, environ の読み手)]（近い順）。environ は claude のときだけ読む。"""
    out, pid = [], os.getppid()
    for _ in range(limit):
        if pid <= 1:
            break
        try:
            argv = [a.decode(errors="replace") for a in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0") if a]
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        out.append((pid, argv))
        try:
            pid = int(stat.rsplit(")", 1)[1].split()[1])
        except (IndexError, ValueError):
            break
    return out


def read_environ(pid):
    """プロセスが起動したときの環境（あとから足した子向けの変数は入らない）。読めなければ None。"""
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return None
    return dict(kv.decode(errors="replace").split("=", 1) for kv in raw.split(b"\0") if b"=" in kv)


def who(env):
    """(claude の pid, 入れ子の claude か)。"""
    if env.get("CLAUDE_STATE_SKIP_NESTED_CHECK"):  # テスト用
        return None, False
    anc = ancestors()
    pid = claude_pid(anc)
    nested = nested_claude([(argv, read_environ(p) if p == pid else None) for p, argv in anc])
    return pid, nested


def pane(env):
    """(window id, socket)。kitty の外なら None。"""
    try:
        wid = int(env.get("KITTY_WINDOW_ID", ""))
    except ValueError:
        return None
    sock = env.get("KITTY_LISTEN_ON")
    return (wid, sock) if sock else None


def session_for_window(d, wid, sock):
    hits = [e for e in all_states(d) if e.get("window") == wid and e.get("socket") == sock]
    hits.sort(key=lambda e: e.get("updated") or 0, reverse=True)
    return hits[0]["session_id"] if hits else None


def apply(event, payload, env, now=None):
    """イベントを state に反映し、色とタブの題を変える。何をしたかを文字列で返す（テストと手での確認用）。"""
    now = time.time() if now is None else now
    if env.get("CLAUDE_KITTY_STATE") == "off":
        return "off"
    p = pane(env)
    if p is None:
        return "outside kitty"
    wid, sock = p
    d = state_dir(env)
    sid = payload.get("session_id")
    if not sid and event == "manual-waiting":
        sid = env.get("CLAUDE_CODE_SESSION_ID") or session_for_window(d, wid, sock)
    if not valid_session_id(sid):
        return "no session id"
    with session_lock(d, sid) as got:
        if not got:
            log_error(env, event, "セッションのロックを 5 秒で取れず、このイベントを捨てた")
            return "busy"
        return _apply(event, payload, env, now, d, sid, wid, sock)


def _apply(event, payload, env, now, d, sid, wid, sock):
    path = state_file(d, sid)
    prev = load(path)
    if event == "UserPromptSubmit" and "<cross-session-message" in str(payload.get("prompt") or ""):
        payload = dict(payload, _notice=is_notice(payload["prompt"], conf(env)["notice"]))
    if event == "Stop" and (prev or {}).get("main") and not (prev or {}).get("quiet") and payload.get("transcript_path"):
        # UserPromptSubmit で通知と分からなかったとき（hook の入力に本文が無い版など）の備え: 会話記録で確かめる
        origin, body = turn_origin(payload["transcript_path"])
        if origin == "peer" and body and is_notice(None, conf(env)["notice"], body=body):
            payload = dict(payload, _notice_turn=True)
    new = transition(prev, event, payload, now)
    if new is None:
        return "unchanged"  # ほとんどの PostToolUse はここで終わる（祖先をたどる前に、速く）
    cpid, nested = who(env)
    if nested:
        return "nested claude"
    c = conf(env)
    kit = Kitten(kitten_path(env), sock, KITTEN_TIMEOUT)
    was_waiting = (prev or {}).get("state") == "waiting"
    if new["state"] == "end":
        path.unlink(missing_ok=True)
        kit("set-colors", "--match", f"id:{wid}", f"background={c['base']}")
        if was_waiting:
            with state_lock(d) as got:
                if got:
                    refresh_marks(kit, d, c["left"])
        return "end"
    new.update(session_id=sid, window=wid, socket=sock)
    if cpid:
        new["pid"] = cpid
    if payload.get("cwd"):
        new["cwd"] = payload["cwd"]
    osw_list = None
    if "role" not in new or (prev or {}).get("window") != wid or new["state"] == "done":
        osw_list = kit.ls()
        hit = find_window(osw_list or [], wid)
        if hit:
            new["role"] = (hit[2].get("user_vars") or {}).get("role")
    # 終わった時点でユーザーがそのペインを見ているなら、未読（done）にしない
    if new["state"] == "done" and viewing(osw_list, wid):
        new = transition(new, "seen", {}, now)
    # watcher（kitty の中）は設定を読まないので、done から戻す色と、今の色（設定の読み直しで消えたら塗り直す）を記録に持たせる
    new["idle_background"] = background_for("idle", c["colors"], c["base"])
    new["background"] = background_for(new["state"], c["colors"], c["base"])
    new["done_dwell"] = c["done_dwell"]  # done のペインにフォーカスがこれだけ続いたら見たとする（watcher が使う）
    # 同じペインの古い記録（/clear で新しいセッションになったなど）は消す（古い waiting で印が残らないよう）
    stale_waiting = False
    for e in all_states(d):
        if e.get("session_id") != sid and e.get("window") == wid and e.get("socket") == sock:
            stale_waiting |= e.get("state") == "waiting"
            state_file(d, e["session_id"]).unlink(missing_ok=True)
    save(path, new)
    # 別のペインで resume した: 前のペインを使う記録がもう無ければ、前のペインの色を元に戻す
    pw = (prev or {}).get("window")
    if (isinstance(pw, int) and pw != wid and prev.get("socket") == sock
            and not any(e.get("window") == pw and e.get("socket") == sock for e in all_states(d))):
        kit("set-colors", "--match", f"id:{pw}", f"background={c['base']}")
    if (prev or {}).get("state") != new["state"] or (prev or {}).get("window") != wid:
        kit("set-colors", "--match", f"id:{wid}", f"background={background_for(new['state'], c['colors'], c['base'])}")
    if was_waiting != (new["state"] == "waiting") or stale_waiting:
        with state_lock(d) as got:
            if got:
                refresh_marks(kit, d, c["left"])
    return new["state"]


def cmd_hook(event, env):
    """hook 本体。何が起きても exit 0、stdout には何も出さない（UserPromptSubmit では文脈に入るため）。"""
    try:
        text = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()  # 大きな tool_response でも切らない
        apply(event, parse_hook_input(text), env)
    except BaseException as e:  # noqa: BLE001 — hook は Claude Code を止めない
        log_error(env, event, f"{type(e).__name__}: {e}")
    return 0


def log_error(env, event, msg):
    try:
        log = state_dir(env) / "errors.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        if not log.exists() or log.stat().st_size < 256 * 1024:  # 溜め込まない
            with open(log, "a") as f:
                f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {event}: {msg}\n")
    except BaseException:  # noqa: BLE001
        pass


def cmd_watch(env, to=None, interval=1.0, once=False, sleep=time.sleep, now=time.time, monotonic=time.monotonic):
    """常駐: interval 秒ごとに全部の kitty の前面のペインを見て、done が done_dwell 秒続いたら idle にする。

    落ちない（例外は errors.log に残して続ける。それでも落ちたら systemd が起こし直す）。
    """
    from statewatch import Watch, find_sockets
    c = conf(env)
    kpath = kitten_path(env)

    def set_bg(sock, wid, bg):
        return Kitten(kpath, sock, KITTEN_TIMEOUT)("set-colors", "--match", f"id:{wid}", f"background={bg}") is not None

    try:
        w = Watch(state_dir(env), c["colors"], c["base"], set_bg=set_bg, log=lambda m: log_error(env, "watch", m))
    except Exception as e:  # noqa: BLE001 — watcher のファイルが無いなど。systemd が起こし直す前に理由を残す
        log_error(env, "watch", f"起動できない: {type(e).__name__}: {e}")
        raise
    configured = list(to or []) or c.get("watch_sockets")
    while True:
        t, m0 = now(), monotonic()
        try:
            for sock, wid, sid in w.tick(find_sockets(env, configured), t):
                if once:
                    print(f"{sock} window {wid}: {sid} → idle")
        except Exception as e:  # noqa: BLE001
            log_error(env, "watch", f"{type(e).__name__}: {e}")
        if once:
            return 0
        sleep(min(interval, max(0.05, interval - (monotonic() - m0))))  # 待つ時間は単調な時計で（壁時計が戻っても止まらない）


def current(env, sid):
    sid = sid or env.get("CLAUDE_CODE_SESSION_ID")
    if not valid_session_id(sid):
        return None
    e = load(state_file(state_dir(env), sid))
    return e if e and alive(e) else None


def main(argv=None):
    env = os.environ
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) == 2 and argv[0] == "hook":  # hook はツールを使うたびに走るので、argparse を読み込まない
        return cmd_hook(argv[1], env)
    if argv == ["--version"]:  # 版の表示だけは設定や kitty を読まずに返す
        from version import handle_version
        handle_version(argv, "claude-state")
        return 0
    import argparse
    ap = argparse.ArgumentParser(prog="claude-state")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("hook"); p.add_argument("event")
    sub.add_parser("waiting")
    p = sub.add_parser("get"); p.add_argument("session", nargs="?")
    p = sub.add_parser("paint"); p.add_argument("session"); p.add_argument("text")
    p = sub.add_parser("list"); p.add_argument("--json", action="store_true")
    p.add_argument("--all", action="store_true", help="終わったはずの記録（claude が動いていない）も出す")
    p = sub.add_parser("marks"); p.add_argument("--clear", action="store_true"); p.add_argument("--to")
    p = sub.add_parser("repaint"); p.add_argument("--to")
    p = sub.add_parser("subagents"); p.add_argument("session", nargs="?")
    p = sub.add_parser("watch"); p.add_argument("--to", action="append", help="見る kitty の socket（何度でも。省くと設定か $XDG_RUNTIME_DIR/kitty-*）")
    p.add_argument("--interval", type=float, default=1.0); p.add_argument("--once", action="store_true", help="1 回だけ見て終わる（確かめ用）")
    args = ap.parse_args(argv)

    if args.cmd == "hook":
        return cmd_hook(args.event, env)
    if args.cmd == "waiting":
        r = apply("manual-waiting", {}, env)
        print(r)
        return 0
    if args.cmd == "get":
        e = current(env, args.session)
        print(e["state"] if e else "")
        return 0
    if args.cmd == "paint":
        e = current(env, args.session)
        sys.stdout.write(paint(args.text, e["state"], conf(env)["colors"]) if e else args.text)
        return 0
    if args.cmd == "list":
        entries = [e for e in all_states(state_dir(env)) if args.all or alive(e)]
        rows = list_rows(entries, time.time())
        print(json.dumps(rows, ensure_ascii=False) if args.json else format_list(rows))
        return 0
    if args.cmd == "marks":
        sock = args.to or env.get("KITTY_LISTEN_ON")
        if not sock:
            print("claude-state: kitty の外では --to SOCKET を指定する", file=sys.stderr)
            return 1
        d = state_dir(env)
        with state_lock(d) as got:
            ops = refresh_marks(Kitten(kitten_path(env), sock, KITTEN_TIMEOUT), d, conf(env)["left"], args.clear)
        for tab_id, title in ops:
            print(f"tab {tab_id}: {title}")
        return 0 if got else 1
    if args.cmd == "subagents":
        e = current(env, args.session)
        sys.stdout.write(subagent_summary(e, time.time(), conf(env)["subagent_colors"]) if e else "")
        return 0
    if args.cmd == "watch":
        return cmd_watch(env, args.to, max(0.2, args.interval), args.once)
    if args.cmd == "repaint":
        sock = args.to or env.get("KITTY_LISTEN_ON")
        if not sock:
            print("claude-state: kitty の外では --to SOCKET を指定する", file=sys.stderr)
            return 1
        c = conf(env)
        kit = Kitten(kitten_path(env), sock, KITTEN_TIMEOUT)
        for wid, bg in repaint_ops(all_states(state_dir(env)), sock, c["colors"], c["base"], alive):
            ok = kit("set-colors", "--match", f"id:{wid}", f"background={bg}") is not None
            print(f"window {wid}: {bg}{'' if ok else ' (失敗)'}")
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""kitty の claude-code ペインを決まった形に並べ替える（統括用）。

  claude-view all                    kitty にいる全員を main タブに 2 段で並べる（いまの並び順を保つ）
  claude-view focus ROLE             ROLE を右の大きな枠に出し、ほかは standby タブへ
  claude-view pair ROLE ROLE         右の上下に 2 人
  claude-view restore                最初の配置（設定の view.restore。既定は右上 dev-a、右下 dev-b）
  claude-view add ROLE [--row N]     いまの配置に ROLE を足す（既定は人数の少ない段、N は上から 0,1,…）
  claude-view remove ROLE            ROLE を standby タブへ下げる
  claude-view swap A B               A と B の位置を入れ替える（片方が standby なら、もう片方と交代）
  claude-view equalize               いまの配置のまま等分割にそろえる
  claude-view rows "a,b/c"           任意の段組み（/ で段、, で横並び）
  claude-view status                 いまの配置
  claude-view hot WINDOW_ID|ROLE     そのペインを統括の右の 2 列目に縦 100% で出す（kitty の tall レイアウト）。
                                     もう一度（tall のまま、出したペインか統括に）すると元の splits の配置に戻す。
                                     kitty.conf の map から `launch --type=background … hot @active-kitty-window-id` で呼ぶ
どの操作も最後は等分割（段ごとに幅を等しく、統括の左の列も 1 列分）にそろえる。
設定の view.pinned の役割は統括と同じく常時表示: どの操作のあとも右側の 1 段目の先頭（複数ならその順）に置き、
focus・remove などで standby に下げない（kitty にいなければ警告して続ける）。
  共通: --left ROLE（既定は設定の view.left か $CLAUDE_VIEW_LEFT、無ければ main）、--to SOCKET、--dry-run、
        --force（保護する窓が前面でも実行）

左の枠（統括）は動かさず、最後に入力先を左へ戻す（hot だけは、呼ぶ前の入力先へ戻す。キーで呼べば押したペイン）。
ペインを閉じる操作と send-text は使わない。
hot の失敗は stderr のほか $XDG_RUNTIME_DIR/claude-view/errors.log にも残す（キーから呼ぶと stderr はどこにも出ない）。
設定の view.guard（プロセスの正規表現）に当たる窓（全画面のアプリや発表中の画面など、キーやフォーカスを奪われたくない窓）が前面にあるときは何もせず、通知だけする。
設定は lib/config.py（~/.config/claude-kitty/config.json と環境変数）。
"""
import argparse
import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "lib"))
import time  # noqa: E402

from config import kitten_path, load_view_config  # noqa: E402
from geometry import tab_pane_fraction  # noqa: E402
from guard import guarded_in_front as _guarded_in_front  # noqa: E402
from kstate import Kitten, refresh_marks, state_dir, state_lock  # noqa: E402
from rundir import live_kitty_sockets, runtime_dir  # noqa: E402
from view import (active_pins, add_role, column_of, current_rows, find_window, focused_window,  # noqa: E402
                  is_hot, overlay_ids, parse_rows, pin_rows, plan, remove_role, role_window, split_two,
                  swap_roles, validate)

KITTEN = kitten_path(os.environ)
STANDBY = "standby"
# hot はキーから launch --type=background で呼ばれ、stderr がどこにも出ない。失敗を残す先（main が決める）
ERROR_LOG = None
LOG_MAX = 256 * 1024


def log_error(msg):
    if ERROR_LOG is None:
        return
    try:
        ERROR_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        # 上限を超えたら .1 に回す（止めると、いちばん見たい新しい失敗が残らない）
        if ERROR_LOG.exists() and ERROR_LOG.stat().st_size >= LOG_MAX:
            os.replace(ERROR_LOG, ERROR_LOG.with_name("errors.log.1"))
        with open(ERROR_LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {' '.join(sys.argv[1:])}: {msg}\n")
    except OSError:
        pass


_LOCK = None


def take_lock():
    """claude-view 同士の並べ替えを 1 つずつにする（同時に動くと形が崩れる）。同じプロセスで 2 回目は何もしない
    （flock は開いたファイルごとなので、開き直すと自分を待って止まる）。"""
    global _LOCK
    if _LOCK is None:
        _LOCK = open(runtime_dir() / "claude-view.lock", "w")
        fcntl.flock(_LOCK, fcntl.LOCK_EX)


def die(msg, code=1):
    print(f"claude-view: {msg}", file=sys.stderr)
    log_error(msg)
    sys.exit(code)


def kitty_socket(arg, left):
    if arg:
        return arg
    if os.environ.get("KITTY_LISTEN_ON"):
        return os.environ["KITTY_LISTEN_ON"]
    # 生きている kitty の socket（$XDG_RUNTIME_DIR か /tmp の kitty-<pid>。落ちて残ったものは除く）
    live = live_kitty_sockets(os.environ)
    # kitty.conf の map の launch --type=background の子には KITTY_LISTEN_ON が渡らない（kitty 0.51 で計測）。
    # 親が kitty なので、listen_on の kitty-{kitty_pid} の名前から決める（キーを押した kitty を取り違えない）
    parent = [s for s in live if os.path.basename(s) == f"kitty-{os.getppid()}"]
    if parent:
        return parent[0]
    if not live:
        die("kitty が見つからない（kitty の中で動かすか、claude-kitty で起動する。別の場所の socket なら --to で指定する）")
    # 統括（左の枠）のいる kitty を選ぶ（テスト用の kitty が同時にあっても取り違えない）
    hits = [s for s in live if any(w["user_vars"].get("role") == left for w in windows(ls(s)))]
    if len(hits) != 1:
        die("対象の kitty を 1 つに決められない（--to で指定する）")
    return hits[0]


def kitten(sock, *args, check=True):
    r = subprocess.run([KITTEN, "@", "--to", sock, *args], capture_output=True, text=True)
    if check and r.returncode:
        die(f"kitten @ {' '.join(args)} に失敗: {r.stderr.strip()}")
    return r.stdout


def ls(sock):
    out = kitten(sock, "ls")
    try:
        data = json.loads(out)
    except ValueError:
        die(f"kitten @ ls の出力が読めない: {out[:80]!r}")
    if not isinstance(data, list):
        die(f"kitten @ ls の出力が読めない: {out[:80]!r}")
    return data


def windows(osw_list):
    for osw in osw_list:
        for tab in osw["tabs"]:
            yield from tab["windows"]


def role_map(osw_list):
    """role → (window id, tab)。"""
    out = {}
    for osw in osw_list:
        for tab in osw["tabs"]:
            skip = overlay_ids(tab)
            for w in tab["windows"]:
                if w["id"] in skip:
                    continue
                role = w.get("user_vars", {}).get("role")
                if role:
                    out[role] = (w["id"], tab)
    return out


def guarded_in_front(patterns):
    """patterns に当たるプロセスの窓が前面なら True（lib/guard.py）。pgrep が失敗したら止める。"""
    try:
        return _guarded_in_front(patterns)
    except ValueError as e:
        die(str(e))


def execute(sock, ops, main_tab_id, roles, dry):
    for op in ops:
        if dry:
            print(" ".join(map(str, op)))
            continue
        kind = op[0]
        if kind == "park":
            kitten(sock, "detach-window", "--match", f"id:{roles[op[1]]}", "--target-tab", "@title",
                   "--tab-title", STANDBY, "--create-if-missing", "--stay-in-tab")
        elif kind == "bring":
            kitten(sock, "detach-window", "--match", f"id:{roles[op[1]]}", "--target-tab", f"id:{main_tab_id}")
        elif kind == "focus":
            kitten(sock, "focus-window", "--match", f"id:{roles[op[1]]}")
        elif kind == "rotate":
            kitten(sock, "action", "layout_action", "rotate")
        elif kind == "bias":
            kitten(sock, "action", "layout_action", "bias", str(op[1]))


def hot(sock, target, left, dry):
    """target を統括の右の 2 列目に縦 100% で出す（tall）。tall で出しているペインか統括なら splits に戻す。

    tall の列の幅は 2 列とも同じ（bias=60 で 30%/30%/右 40%）。resize で寄せると数秒ガクガク動くので
    寄せない（利用者の判断「最初の一発で大きくなるほうがいい」）。kitty.conf の enabled_layouts の
    tall:bias=60;full_size=2 がそのまま効く。
    """
    osw_list = ls(sock)
    found = find_window(osw_list, target)
    if not found:
        die(f"{target} が kitty に見つからない")
    wid, tab = found
    left_id = role_window(tab, left)
    back = focused_window(osw_list) or wid
    ops = []
    if tab.get("layout") == "tall" and (left_id is None or wid == left_id or is_hot(tab, wid, left_id)):
        # 戻すのは goto_layout splits（splits の分割の木がそのまま戻る）。toggle_layout・last_used_layout では
        # splits に戻らなかった（kitty 0.51 で計測）
        ops = [("goto-layout", "--match", f"window_id:{wid}", "splits")]
    else:
        if left_id is None:
            die(f"{target} のタブに統括（{left}）がいない（統括の右に出すので中止）")
        if wid == left_id:
            die(f"{target} は統括（{left}）自身（統括の右に出すものではないので中止）")
        ops = [("goto-layout", "--match", f"window_id:{wid}", "tall"),
               # tall は列の幅の偏りを覚えている（前の resize が残り、注目の列が 70% になった）。毎回、設定の bias に戻す
               ("resize-window", "--match", f"id:{wid}", "--axis", "reset")]
        # move_window_to_top・move_window_backward は入力先の窓に効く（action の --match は効かなかった）ので、
        # いったんフォーカスを移して並べ、最後に呼ぶ前の入力先へ戻す
        ops += [("focus-window", "--match", f"id:{left_id}"), ("action", "move_window_to_top"),
                ("focus-window", "--match", f"id:{wid}"), "backward"]
    ops.append(("focus-window", "--match", f"id:{back}"))
    if dry:
        for op in ops:
            print("move_window_backward（2 列目まで）" if op == "backward" else " ".join(op))
        return 0
    try:
        for op in ops[:-1]:
            if op == "backward":
                to_second(sock, tab["id"], wid, left_id, target)
            else:
                kitten(sock, *op)
    finally:
        # 途中で失敗しても、入力先は呼ぶ前のペインへ戻す（統括や注目のペインに移ったままにしない）
        kitten(sock, *ops[-1], check=False)
    return 0


def to_second(sock, tab_id, wid, left_id, target):
    """統括が 0 番にいることを確かめ、wid を 1 番（統括のすぐ右）まで move_window_backward で前へ出す。

    フォーカスが注目のペインに移っている間（打った文字がそこに入る）を短くするため、ls は 1 回にして
    要る回数をまとめて送り、もう一度の ls で確かめる。kitty の動きが違ったときのために、やり直しは 3 回まで。
    """
    for _ in range(3):
        cur = next((t for o in ls(sock) for t in o.get("tabs") or [] if t.get("id") == tab_id), None)
        if cur is None:
            die("並べ替えの途中でタブが見つからなくなった")
        if column_of(cur, left_id) != 0:
            die("統括を先頭に動かせなかった")
        col = column_of(cur, wid)
        if col is None:
            die(f"並べ替えの途中で {target} が見つからなくなった")
        if col == 1:
            return
        for _ in range(col - 1):
            kitten(sock, "action", "move_window_backward")
    die(f"{target} を 2 列目に動かせなかった")


def status(sock):
    for osw in ls(sock):
        for tab in osw["tabs"]:
            names = [w.get("user_vars", {}).get("role", str(w["id"])) for w in tab["windows"]]
            print(f"{tab['title']}{' *' if tab['is_active'] else ''}: {', '.join(names)}")


def main(argv=None):
    if (sys.argv[1:] if argv is None else argv) == ["--version"]:  # 版の表示だけは設定や kitty を読まずに返す
        from version import handle_version
        handle_version((sys.argv[1:] if argv is None else argv), "claude-view")
        return 0
    try:
        conf = load_view_config(os.environ)
    except ValueError as e:
        die(str(e))
    ap = argparse.ArgumentParser(prog="claude-view")
    ap.add_argument("--left", default=conf["left"])
    ap.add_argument("--to")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="保護する窓（view.guard）が前面でも実行する")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("all", "restore", "status", "equalize"):
        sub.add_parser(name)
    p = sub.add_parser("focus"); p.add_argument("role")
    p = sub.add_parser("pair"); p.add_argument("top"); p.add_argument("bottom")
    p = sub.add_parser("rows"); p.add_argument("spec")
    p = sub.add_parser("add"); p.add_argument("role"); p.add_argument("--row", type=int)
    p = sub.add_parser("remove"); p.add_argument("role")
    p = sub.add_parser("swap"); p.add_argument("a"); p.add_argument("b")
    p = sub.add_parser("hot"); p.add_argument("target", metavar="WINDOW_ID|ROLE")
    args = ap.parse_args(argv)
    if args.cmd == "hot":
        global ERROR_LOG
        ERROR_LOG = runtime_dir() / "claude-view" / "errors.log"
        try:
            return run_hot(args, conf)
        except SystemExit:
            raise
        except Exception as e:  # キーから呼ぶと traceback はどこにも出ないので、残してから落とす
            die(f"{type(e).__name__}: {e}")

    sock = kitty_socket(args.to, args.left)
    if args.cmd == "status":
        return status(sock)
    snapshot = ls(sock)
    smap = role_map(snapshot)
    if args.left not in smap:
        die(f"{args.left} が kitty に見つからない")
    if smap[args.left][1].get("layout") == "tall":
        # hot で tall にしたままのタブ。並べ替えは splits の分割の木が前提なので、先に splits に戻す
        if args.dry_run:
            # tall の位置からは段を正しく読めない（2 列目と右の列の上が同じ段に見える）ので、ここで止める
            print("goto-layout splits（tall から戻す。戻したあとの操作は、戻すまで決まらないので表示しない）")
            return 0
        else:
            if not args.force and guarded_in_front(conf["guard"]):
                die("保護する窓（view.guard）が前面にあるので何もしない（--force で実行）", 2)
            take_lock()  # hot の並べ替えの途中で splits に切り替えないよう、戻す前から取る
            kitten(sock, "goto-layout", "--match", f"window_id:{smap[args.left][0]}", "splits")
            snapshot = ls(sock)
            smap = role_map(snapshot)
            if args.left not in smap:
                die(f"{args.left} が kitty に見つからない")
    now = current_rows(smap[args.left][1], args.left, tab_pane_fraction)
    others = [r for r in smap if r != args.left and all(r not in row for row in now)]
    try:
        rows = {"all": lambda: split_two([r for row in now for r in row] + others),
                "restore": lambda: conf["restore"],
                "equalize": lambda: now,
                "focus": lambda: [[args.role]], "pair": lambda: [[args.top], [args.bottom]],
                "rows": lambda: parse_rows(args.spec),
                "add": lambda: add_role(now, args.role, args.row),
                "remove": lambda: remove_role(now, args.role),
                "swap": lambda: swap_roles(now, args.a, args.b)}[args.cmd]()
    except ValueError as e:
        die(str(e))
    # pinned を先頭に移すと、指定そのものの誤り（rows・restore・pair で 2 回出てくるなど）が消えて黙って通るので、
    # 移す前の形で調べておく。断るのは保護する窓の判定のあと（前面なら誤りでも終了コード 2 のまま）
    try:
        validate(args.left, rows, smap.keys())
        spec_error = None
    except ValueError as e:
        spec_error = str(e)
    # 常時表示（view.pinned）は、どの操作のあとでも 1 段目の先頭へ戻す
    pins, notes = active_pins(conf["pinned"], args.left, smap.keys())
    for note in notes:
        print(f"claude-view: 注意: {note}", file=sys.stderr)
    if args.cmd == "remove" and args.role in pins:
        print(f"claude-view: 注意: {args.role} は常時表示（view.pinned）なので下げない", file=sys.stderr)
    if args.cmd == "swap" and {args.a, args.b} & set(pins):
        # 入れ替えても先頭へ戻すので、相手の位置だけが動いて段の形が崩れる。黙って崩さず断る
        die(f"{(set(pins) & {args.a, args.b}).pop()} は常時表示（view.pinned）で場所が固定なので入れ替えない")
    pinned_rows = pin_rows(rows, pins)
    moved = pins and pinned_rows != rows
    rows = pinned_rows

    if not args.dry_run and not args.force and guarded_in_front(conf["guard"]):
        die("保護する窓（view.guard）が前面にあるので何もしない（--force で実行）", 2)
    if spec_error:
        die(spec_error)
    if moved:  # 何もしないとき（保護する窓が前面）には出さない
        print("常時表示（view.pinned）を 1 段目の先頭に置いた: " + "/".join(",".join(r) for r in rows))

    # 同時に 2 つ並べ替えると形が崩れるので 1 つずつ
    take_lock()
    osw_list = ls(sock)
    rmap = role_map(osw_list)
    try:
        validate(args.left, rows, rmap.keys())
    except ValueError as e:
        die(str(e))
    left_id, main_tab = rmap[args.left]
    # overlay（claude-show の画像など）は重ねた先のペインと一緒に動くので数えない
    main_roles = [w.get("user_vars", {}).get("role") for w in main_tab["windows"] if w["id"] not in overlay_ids(main_tab)]
    if None in main_roles:
        die("main タブに role の無いペインがある（並べ替えの対象外なので中止）")
    roles = {r: wid for r, (wid, _) in rmap.items()}
    ops = plan(args.left, rows, main_roles)
    if args.dry_run:
        execute(sock, ops, main_tab["id"], roles, True)
        return
    # claude-state が待受中のペインのいるタブの題に「●」を付けるので、standby を題で探す前に外し、
    # 並べ替えたあとに付け直す（その間は hook に付けさせない）
    d = state_dir()
    kit = Kitten(KITTEN, sock)
    with state_lock(d, timeout=5.0):
        refresh_marks(kit, d, args.left, clear=True)
        execute(sock, ops, main_tab["id"], roles, False)
        refresh_marks(kit, d, args.left)
    status(sock)


def run_hot(args, conf):
    sock = kitty_socket(args.to, args.left)
    if not args.dry_run and not args.force and guarded_in_front(conf["guard"]):
        die("保護する窓（view.guard）が前面にあるので何もしない（--force で実行）", 2)
    # ほかの claude-view と同時に並べ替えると形が崩れるので 1 つずつ
    take_lock()
    return hot(sock, args.target, args.left, args.dry_run)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""kitty のペインに Chrome を「常に最前面」で重ねる。ペインの役割・席ごとに独立した Chrome を持つ。

  claude-browser open URL [--mode self|show] [--ratio R] [--area pane|others|right] [--over SLOT|ROLE|ID] [--focus kitty|browser|none]
  claude-browser move [--mode ...] [--ratio ...] [--area ...] [--over ...] [--focus ...]
  claude-browser shot FILE        前面タブのスクリーンショット（CDP）
  claude-browser url              前面タブの URL
  claude-browser close
  claude-browser status | list
  claude-browser profiles         プロファイル台帳（用途・最終利用・ログイン済みのメモ）
  claude-browser note TEXT        台帳にメモを残す（例: "github: passkey でログイン済み"）
  共通: --key NAME でプロファイル名を明示する

mode self（既定）: 自分だけで確認する。自分のペイン全体（他のペインの邪魔をしない）。
mode show: ユーザーに見せる。自分以外のペインの場所（左の列を除いた右側のうち、自分の横を避けた広い方）に縦 100%。

kitty は縮めない（縮めると全ペインの claude-code が再描画で崩れることがある）。
プロファイル名は起動し直しても変わらないもの（ペインの user var role > slot > セッション ID）。
プロファイルは残すので、パスキー等のログインは一度人が済ませれば以後そのまま使える。
起動する Chrome（Chromium）は設定の browser.command、無ければ自動で探す（順は lib/browser.py。status に出る）。
窓の配置は KDE Plasma の KWin。macOS は試験的に、kitty の窓の矩形を CoreGraphics（lib/macwin.py）で読み、
Chrome の窓を CDP の Browser.setWindowBounds で置く（「常に最前面」は無い。置けなければ普通の窓のまま開く）。
"""
import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "lib"))
import proc  # noqa: E402
from browser import SEARCHED, find_browser  # noqa: E402
from config import kitten_path, load_browser_config, load_view_config  # noqa: E402
from core import (choose_key, kitty_pid_from_socket, ledger_touch,  # noqa: E402
                  parse_journal, profile_processes, resolve_pane, resolve_place_opts)
from geometry import (fit_correction, others_area_fraction, right_area_fraction,  # noqa: E402
                      tab_pane_fraction, target_rect)
from rundir import live_kitty_sockets, runtime_dir  # noqa: E402

KITTEN = kitten_path(os.environ)
CHROME_FLAGS = [
    "--no-first-run", "--no-default-browser-check",
    # 別デスクトップや他の窓の下にあっても描画を止めない（shot がタイムアウトしないように）
    "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding",
    "--disable-background-timer-throttling",
]
# 起動する Chrome とプロファイルの置き場は setup_browser() が決める（探す順と置き場は lib/browser.py）。
# Flatpak なら ~/.var/app/<アプリ ID>/claude-profiles（サンドボックスから書ける場所）、ほかは
# $XDG_DATA_HOME/claude-kitty/browser-profiles（macOS は ~/Library/Application Support/claude-kitty/browser-profiles）。
# 設定の browser.command / browser.profile_root で変える
CHROME = None
BROWSER = None
PROFILE_ROOT = None
LEDGER = None
STATE_DIR = runtime_dir() / "claude-browser"
PLATFORM = sys.platform  # テストで偽の OS にするため
CDP = HERE / "lib" / "cdp.mjs"
PLACE_KEYS = ("mode", "ratio", "over", "focus", "area")  # 既定と引き継ぎは core.resolve_place_opts
SETTLE = 0.4  # 配置してから、窓の大きさが落ち着くまで待つ秒数（Chrome が自分で大きさを戻すことがある）


def die(msg):
    print(f"claude-browser: {msg}", file=sys.stderr)
    sys.exit(1)


# ---------- browser ----------
def flatpak_has(app):
    try:
        return subprocess.run(["flatpak", "info", app], stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


NO_BROWSER = (f"Chrome / Chromium が見つからない（探したもの: {SEARCHED}）。"
              "入れるか、設定の browser.command で起動のコマンドを書く（docs/config.md）")


def setup_browser(env=None, strict=True):
    """起動する Chrome とプロファイルの置き場を決め、CHROME / PROFILE_ROOT / LEDGER に入れる。

    見つからなくても止めない（list・profiles・close はプロファイルの置き場だけで動く）。止めるのは open。
    設定が壊れていれば、strict（open / move）なら止め、ほかは既定の探し方で続ける（close できなくならないように）。"""
    global BROWSER, CHROME, PROFILE_ROOT, LEDGER
    env = os.environ if env is None else env
    try:
        conf = load_browser_config(env)
    except ValueError as e:
        if strict:
            die(str(e))  # 壊れた設定のまま、別のブラウザ・別のプロファイルで開かない
        print(f"claude-browser: {e}（既定で続ける）", file=sys.stderr)
        conf = {"command": None, "profile_root": None}
    import shutil
    BROWSER = find_browser(conf, env, Path.home(), lambda n: shutil.which(n, path=env.get("PATH")),
                           os.path.exists, flatpak_has, os.uname().sysname)
    CHROME = BROWSER["command"]
    PROFILE_ROOT = BROWSER["profile_root"]
    LEDGER = PROFILE_ROOT / "ledger.json"
    return BROWSER


# ---------- state / process ----------
def state_path(key):
    return STATE_DIR / f"{key}.json"


def load_state(key):
    try:
        return json.loads(state_path(key).read_text())
    except (OSError, ValueError):
        return None


def save_state(key, st):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state_path(key).write_text(json.dumps(st))


def scan_procs():
    """[(pid, 引数のリスト)]（Linux は /proc、macOS は sysctl。lib/proc.py）。"""
    return proc.processes()


def running(profile):
    """このプロファイルの Chrome の (pid 一覧, ポート)。ポートはプロセスの引数から取る（持ち主の確認を兼ねる）。"""
    found = profile_processes(scan_procs(), str(profile), loose=not proc.is_linux())
    ports = [p for _, p in found if p]
    return [pid for pid, _ in found], (ports[0] if ports else None)


def http_ok(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=1):
            return True
    except OSError:
        return False


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def node(port, *args, check=True):
    r = subprocess.run(["node", str(CDP), str(port), *args], capture_output=True, text=True)
    if check and r.returncode:
        die(r.stderr.strip() or f"cdp {args[0]} に失敗")
    return r


def update_ledger(key, **kw):
    """台帳は記録でしかないので、失敗しても本来の操作は止めない。複数ペインの同時更新は flock で順番に。"""
    import fcntl
    import tempfile
    try:
        PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
        with open(PROFILE_ROOT / "ledger.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                cur = json.loads(LEDGER.read_text())
            except (OSError, ValueError):
                cur = {}
            new = ledger_touch(cur, key, time.strftime("%Y-%m-%d %H:%M"),
                               session=os.environ.get("CLAUDE_CODE_SESSION_ID"), **kw)
            with tempfile.NamedTemporaryFile("w", dir=PROFILE_ROOT, delete=False, suffix=".tmp") as tmp:
                tmp.write(json.dumps(new, ensure_ascii=False, indent=1))
            os.replace(tmp.name, LEDGER)
    except OSError as e:
        print(f"claude-browser: 台帳を更新できない: {e}", file=sys.stderr)


# ---------- kitty ----------
def kitty_socket():
    env = os.environ.get("KITTY_LISTEN_ON")
    if env:
        return env
    # 生きている kitty のソケットだけを候補にする（クラッシュ後に残ったものを拾わない）
    socks = live_kitty_sockets(os.environ)
    if not socks:
        die("kitty が見つからない（kitty の中で動かすか、claude-kitty で起動する。別の kitty なら KITTY_LISTEN_ON を設定する）")
    if len(socks) != 1:
        die("kitty のソケットを 1 つに決められない（KITTY_LISTEN_ON を設定するか kitty の中で呼ぶ）")
    return socks[0]


def kitty_ls(sock):
    out = subprocess.run([KITTEN, "@", "--to", sock, "ls"], capture_output=True, text=True)
    if out.returncode:
        die(f"kitten @ ls に失敗: {out.stderr.strip()}")
    return json.loads(out.stdout)


def own_window_id():
    wid = os.environ.get("KITTY_WINDOW_ID")
    return int(wid) if wid and wid.isdigit() else None


def own_vars(osw_list, own_id):
    for osw in osw_list:
        for tab in osw.get("tabs", []):
            for w in tab.get("windows", []):
                if w["id"] == own_id:
                    return w.get("user_vars", {})
    return {}


# ---------- KWin ----------
from kwin import kwin  # noqa: E402


def find_kitty(kitty_pid, title):
    """kitty の OS ウィンドウ（KWin）を 1 つに決め、(internalId, クライアント領域) を返す。"""
    out = kwin(f"""
const ks = workspace.windowList().filter(w => w.pid === {kitty_pid} && w.normalWindow);
let pick = ks.length === 1 ? ks : ks.filter(w => w.caption === {json.dumps(title)});
if (pick.length === 1) {{
    const g = pick[0].clientGeometry;
    @@OUT@@JSON.stringify({{id: String(pick[0].internalId), x: g.x, y: g.y, w: g.width, h: g.height}}));
}} else {{
    @@OUT@@JSON.stringify({{count: ks.length}}));
}}
@@OUT@@"END");""")
    g = json.loads(out[0]) if out else {"count": 0}
    if "id" not in g:
        die(f"kitty (pid {kitty_pid}) の OS ウィンドウを 1 つに決められない（候補 {g['count']} 個）")
    return g["id"], (g["x"], g["y"], g["w"], g["h"])


def browser_windows(cls):
    out = kwin(f"""
for (const w of workspace.windowList()) if (w.resourceClass === {json.dumps(cls)} && w.normalWindow)
    @@OUT@@JSON.stringify({{id: String(w.internalId), area: w.frameGeometry.width * w.frameGeometry.height}}));
@@OUT@@"END");""")
    return [json.loads(l) for l in out]


def place_browser(cls, browser_id, kitty_id, rect, focus):
    """ブラウザの主ウィンドウだけを配置する（OAuth のポップアップや DevTools は動かさない）。

    実際の矩形 (x, y, w, h) を返す（窓が無ければ None）。最大化の解除は、最大化しているときだけにする
    （解除すると前の大きさに戻す処理が後から走り、指定した大きさを上書きすることがある）。
    """
    x, y, w, h = rect
    out = kwin(f"""
const all = workspace.windowList();
const k = all.find(w => String(w.internalId) === {json.dumps(kitty_id)});
const b = all.find(w => String(w.internalId) === {json.dumps(browser_id)} && w.resourceClass === {json.dumps(cls)});
if (b) {{
    if (k) b.desktops = k.desktops;
    b.minimized = false;
    if (b.maximizeMode !== 0) b.setMaximize(false, false);
    b.keepAbove = true;
    b.frameGeometry = {{x: {x}, y: {y}, width: {w}, height: {h}}};
    if ({json.dumps(focus)} === "kitty" && k) workspace.activeWindow = k;
    else if ({json.dumps(focus)} === "browser") workspace.activeWindow = b;
    const g = b.frameGeometry;
    @@OUT@@JSON.stringify([g.x, g.y, g.width, g.height]));
}}
@@OUT@@"END");""")
    return tuple(json.loads(out[0])) if out else None


def browser_rect(browser_id):
    out = kwin(f"""
const b = workspace.windowList().find(w => String(w.internalId) === {json.dumps(browser_id)});
if (b) {{ const g = b.frameGeometry; @@OUT@@JSON.stringify([g.x, g.y, g.width, g.height])); }}
@@OUT@@"END");""")
    return tuple(json.loads(out[0])) if out else None


def main_browser_window(st):
    """前回配置した窓が残っていればそれ、無ければ一番大きい窓を主ウィンドウとする。"""
    wins = browser_windows(st["class"])
    for w in wins:
        if w["id"] == st.get("kwin_id"):
            return w["id"]
    return max(wins, key=lambda w: w["area"])["id"] if wins else None


# ---------- macOS（試験的）----------
def is_mac():
    return PLATFORM == "darwin"


def warn(msg):
    print(f"claude-browser: {msg}", file=sys.stderr)


def find_kitty_mac(kitty_pid, osw):
    """kitty の OS 窓のクライアント領域を CoreGraphics から読み、(None, (x, y, w, h)) を返す。読めなければ None（止めない）。"""
    from macwin import MacWinError, kitty_client
    try:
        return None, kitty_client(kitty_pid, osw.get("platform_window_id"), os.environ)
    except MacWinError as e:
        warn(f"macOS: kitty の窓の位置を読めないので、ペインに重ねずに普通の窓で開く（{e}）")
        return None


def mac_window_id(port):
    r = node(port, "window", check=False)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip().isdigit() else None


def mac_placement(st, opts, kitty_win, tab, pane):
    """macOS: CDP の Browser.setWindowBounds で Chrome の窓を置く。失敗しても止めない（普通の窓のまま）。

    「常に最前面」は無い。Chrome を前に出す（Page.bringToFront。入力先も Chrome に移る）のは --focus browser の
    ときだけ。既定の kitty と none は入力先を動かさない（打っている途中の文字が Chrome に入らないように）ので、
    Chrome が kitty の後ろに隠れることがある。"""
    st.update(kwin_id=None, mode=opts["mode"], ratio=float(opts["ratio"]),
              over=opts["over"], focus=opts["focus"], area=opts["area"])
    if kitty_win is None:
        return None
    _kid, client = kitty_win
    try:
        frac = area_fraction(opts, tab, pane, own_window_id())
    except (KeyError, ValueError) as e:
        warn(f"重ねる場所を計算できないので、普通の窓のまま（{e}）")
        return None
    rect = target_rect(client, frac, opts["mode"], float(opts["ratio"]))
    wid = mac_window_id(st["port"])
    if wid is None:
        warn("Chrome の窓の ID を CDP で取れないので、普通の窓のまま")
        return None
    r = node(st["port"], "place", wid, *map(str, rect), check=False)
    if r.returncode:
        warn(f"Chrome の窓を置けなかった（{(r.stderr or r.stdout).strip()}）。普通の窓のまま")
        return None
    try:
        got = tuple(json.loads(r.stdout))
    except ValueError:
        got = None
    if opts["focus"] == "browser":
        node(st["port"], "front", check=False)
    else:
        warn("macOS: 入力先を動かさないので、Chrome が kitty の後ろに隠れていることがある（前に出すなら --focus browser）")
    if got and _off(rect, got) > 8:
        warn(f"窓が指定の位置に収まらない（指定 {rect}、実際 {got}）")
    return rect


# ---------- commands ----------
def prepare(args, st, move=False):
    """起動の前に配置先を確定させる（失敗してから Chrome が残らないように）。"""
    opts = resolve_place_opts({k: getattr(args, k, None) for k in PLACE_KEYS}, st, move=move)
    if opts["over"] == "self":
        opts["over"] = None
    target_rect((0, 0, 1, 1), (0, 0, 1, 1), opts["mode"], float(opts["ratio"]))  # 値の検証だけ
    sock = kitty_socket()
    osw_list = kitty_ls(sock)
    try:
        osw, tab, pane = resolve_pane(osw_list, opts["over"], own_window_id())
    except LookupError as e:
        die(str(e))
    kitty_pid = kitty_pid_from_socket(sock)
    if not kitty_pid:
        die(f"kitty のソケット名から pid が分からない: {sock}")
    if is_mac():
        return opts, find_kitty_mac(kitty_pid, osw), tab, pane
    active = next((w for t in osw["tabs"] if t.get("is_active") for w in t["windows"] if w.get("is_active")), pane)
    kitty_win = find_kitty(kitty_pid, active.get("title", ""))  # Chrome を起動する前に決めておく
    return opts, kitty_win, tab, pane


def left_window_id(tab):
    """そのタブで、左の列（view.left の役割）のペインの id。いなければ None。"""
    try:
        left = load_view_config(os.environ)["left"]
    except ValueError:
        left = os.environ.get("CLAUDE_VIEW_LEFT") or DEFAULT_LEFT
    return next((w["id"] for w in tab.get("windows", []) if (w.get("user_vars") or {}).get("role") == left), None)


DEFAULT_LEFT = "main"


def _off(want, got):
    return sum(abs(a - b) for a, b in zip(want, got))


def area_fraction(opts, tab, pane, own_id=None):
    """重ねる場所の割合。pane: そのペイン。right: 左の列（統括）を除いた右側全体。
    others: 右側のうち、自分（呼び出したペイン own_id。--over の先ではない）の横を避けた場所の全高。"""
    area = opts.get("area")
    if area in ("right", "others"):
        right = right_area_fraction(tab, left_window_id(tab))
        if area == "right":
            return right
        own = None  # 自分がこのタブにいない（--over で別のタブ）なら、避けるものが無い
        if own_id is not None and any(w.get("id") == own_id for w in tab.get("windows", [])):
            try:
                own = tab_pane_fraction(tab, own_id)
            except (KeyError, ValueError):
                pass
        return others_area_fraction(right, own)
    return tab_pane_fraction(tab, pane["id"])


def placement(st, opts, kitty_win, tab, pane, settle=SETTLE):
    if is_mac():
        return mac_placement(st, opts, kitty_win, tab, pane)
    kitty_id, client = kitty_win
    try:
        frac = area_fraction(opts, tab, pane, own_window_id())
    except (KeyError, ValueError) as e:
        die(str(e))
    rect = target_rect(client, frac, opts["mode"], float(opts["ratio"]))
    bid = main_browser_window(st)
    got = place_browser(st["class"], bid, kitty_id, rect, opts["focus"]) if bid else None
    if got is None:
        die("ブラウザのウィンドウが見つからない")
    # 指定と実際がずれたら、落ち着いてから直す。1 度目は同じ矩形を置き直す（最大化の解除などで Chrome が後から
    # 前の大きさに戻したとき）。それでもずれていれば、一定のずれ（窓の装飾の分など）なので打ち消す
    for attempt in range(2):
        time.sleep(settle)
        got = browser_rect(bid) or got
        if not fit_correction(rect, got) and all(abs(a - b) <= 2 for a, b in zip(rect, got)):
            break
        fix = rect if attempt == 0 else fit_correction(rect, got)
        if fix is None:
            break  # 大きなずれ: 打ち消すと極端に小さくなりうるので、指定のままにして知らせる
        before = got
        got = place_browser(st["class"], bid, kitty_id, fix, "none") or got
        if attempt == 1:
            time.sleep(settle)
            got = browser_rect(bid) or got
            if _off(rect, got) > _off(rect, before):  # 打ち消して悪くなったら、指定の矩形に戻す
                got = place_browser(st["class"], bid, kitty_id, rect, "none") or got
    st.update(kwin_id=bid, mode=opts["mode"], ratio=float(opts["ratio"]),
              over=opts["over"], focus=opts["focus"], area=opts["area"])
    if _off(rect, got) > 8:
        print(f"claude-browser: 窓が指定の位置に収まらない（指定 {rect}、実際 {got}）", file=sys.stderr)
    return rect


def wait_http(port, seconds):
    for _ in range(int(seconds * 4)):
        if http_ok(port):
            return True
        time.sleep(0.25)
    return False


def has_window(cls, port):
    """Chrome の窓が出ているか（KWin で窓のクラスを探す。macOS は CDP で窓の ID が取れるか）。"""
    if is_mac():
        return mac_window_id(port) is not None
    return bool(browser_windows(cls))


def wait_window(cls, seconds, port=None):
    for _ in range(int(seconds * 4)):
        if has_window(cls, port):
            return True
        time.sleep(0.25)
    return False


def wait_ready(port, cls, seconds):
    for _ in range(int(seconds * 4)):
        if http_ok(port) and has_window(cls, port):
            return True
        time.sleep(0.25)
    return False


def launch_argv(command, profile, port, cls, url):
    """Chrome の起動の引数。--class は X11 では WM_CLASS、Wayland では app_id になり、KWin はそれで窓を探す
    （ネイティブでも Flatpak でも同じ Chrome の引数なので、どちらでも効く）。"""
    return list(command) + [f"--user-data-dir={profile}", f"--remote-debugging-port={port}",
                            f"--class={cls}", *CHROME_FLAGS, "--new-window", url]


def cmd_open(args, key):
    st = load_state(key) or {}
    profile = PROFILE_ROOT / key
    if not CHROME and not running(profile)[0]:  # kitty や KWin を呼ぶ前に止める
        die(NO_BROWSER)
    prep = prepare(args, st)
    cls = f"claude-browser-{key}"
    pids, port = running(profile)
    if pids:
        # state が無くても、同じプロファイルの Chrome が動いていれば引き継ぐ（二重起動は Chrome が拒む）
        if not port or not wait_http(port, 10):
            die(f"このプロファイルの Chrome (pid {pids[0]}) が応答しない。claude-browser close で止める")
        st.update(port=port, **{"class": cls, "profile": str(profile)})
        save_state(key, st)
        node(port, "goto", args.url)  # タブが無ければ cdp.mjs が作る
        if not wait_window(cls, 10, port):
            die("Chrome の窓が出てこない")
    else:
        if not CHROME:
            die(NO_BROWSER)
        port = free_port()
        profile.mkdir(parents=True, exist_ok=True)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with open(STATE_DIR / f"{key}.log", "wb") as log:  # 毎回作り直す（溜め込まない）
            try:
                subprocess.Popen(launch_argv(CHROME, profile, port, cls, args.url),
                                 stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
            except OSError as e:
                die(f"Chrome を起動できない（{' '.join(CHROME)}: {e}）。設定の browser.command を確認する")
        st.update(port=port, **{"class": cls, "profile": str(profile)})
        save_state(key, st)  # 配置に失敗しても後で close / 再 open できるよう、起動直後に残す
        if not wait_ready(port, cls, 20):
            die(f"Chrome が起動しない（ログ: {STATE_DIR / (key + '.log')}）")
    rect = placement(st, *prep)
    save_state(key, st)
    print(json.dumps({"key": key, "port": port, "cdp": f"http://127.0.0.1:{port}",
                      "rect": rect, "mode": st["mode"], "area": st["area"], "profile": str(profile)}), flush=True)
    update_ledger(key, url=args.url, pane_vars=own_vars(kitty_ls(kitty_socket()), own_window_id()))


def need_running(key):
    profile = PROFILE_ROOT / key
    pids, port = running(profile)
    if not pids or not port or not http_ok(port):
        die("このセッションのブラウザは起動していない（open で起動する）")
    st = load_state(key) or {"class": f"claude-browser-{key}", "profile": str(profile)}
    st["port"] = port
    return st


def cmd_move(args, key):
    st = need_running(key)
    rect = placement(st, *prepare(args, st, move=True))
    save_state(key, st)
    print(json.dumps({"key": key, "rect": rect, "mode": st["mode"], "area": st["area"]}))


def cmd_close(args, key):
    profile = PROFILE_ROOT / key
    pids, port = running(profile)
    if port and http_ok(port):
        node(port, "close", check=False)
    for _ in range(20):
        pids, _ = running(profile)
        if not pids:
            break
        time.sleep(0.25)
    for pid in pids:  # 応答しないときは、このプロファイルのプロセスだけを止める
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    state_path(key).unlink(missing_ok=True)
    print("closed" if not pids else f"closed (SIGTERM {pids})")


def cmd_list():
    keys = {p.stem for p in STATE_DIR.glob("*.json")} | (
        {p.name for p in PROFILE_ROOT.iterdir() if p.is_dir()} if PROFILE_ROOT.exists() else set())
    for key in sorted(keys):
        pids, port = running(PROFILE_ROOT / key)
        st = load_state(key) or {}
        print(json.dumps({"key": key, "running": bool(pids), "port": port,
                          "mode": st.get("mode"), "area": st.get("area"), "over": st.get("over")}))


def main(argv=None):
    if (sys.argv[1:] if argv is None else argv) == ["--version"]:  # 版の表示だけは設定や kitty を読まずに返す
        from version import handle_version
        handle_version((sys.argv[1:] if argv is None else argv), "claude-browser")
        return 0
    ap = argparse.ArgumentParser(prog="claude-browser")
    ap.add_argument("--key", help="プロファイル名を明示する（既定: ペインの role / slot / セッション ID）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def place_opts(p):
        p.add_argument("--mode", choices=["self", "show"],
                       help="self: 自分だけで確認する（既定、自分のペイン）。show: ユーザーに見せる（既定で他のペインの場所に縦 100%%）")
        p.add_argument("--ratio", type=float,
                       help="show のとき範囲の上から何割をブラウザにするか（0.1〜1.0。既定 others は 1.0、pane / right は 0.65）")
        p.add_argument("--over", help="重ねるペイン（slot 名・role 名・kitty の window id、self で自分）。既定は前回の値か自分のペイン")
        p.add_argument("--area", choices=["pane", "others", "right"],
                       help="重ねる場所。既定は self なら pane、show なら others（--over を指定すれば pane、move で省くと前回の場所）。"
                            "pane: ペイン、others: 左の列（統括）を除いた右側のうち自分の横を避けた広い方、"
                            "right: 左の列を除いた kitty の右側全体")
        p.add_argument("--focus", choices=["kitty", "browser", "none"],
                       help="配置後の入力先。none は何も変えない（全画面のアプリを使っている最中など）")

    p = sub.add_parser("open"); p.add_argument("url"); place_opts(p)
    p = sub.add_parser("move"); place_opts(p)
    sub.add_parser("close"); sub.add_parser("status"); sub.add_parser("list"); sub.add_parser("url")
    sub.add_parser("profiles")
    p = sub.add_parser("note"); p.add_argument("text")
    p = sub.add_parser("shot"); p.add_argument("file")
    args = ap.parse_args(argv)
    setup_browser(strict=args.cmd in ("open", "move"))

    if args.cmd == "list":
        return cmd_list()
    if args.cmd == "profiles":
        print(LEDGER.read_text() if LEDGER.exists() else "{}")
        return
    vars_ = {}
    if not args.key and own_window_id() is not None:
        vars_ = own_vars(kitty_ls(kitty_socket()), own_window_id())
    try:
        key = choose_key(args.key, vars_, os.environ)
        if getattr(args, "ratio", None) is not None:
            target_rect((0, 0, 1, 1), (0, 0, 1, 1), "show", args.ratio)
    except ValueError as e:
        die(str(e))
    if args.cmd == "open":
        cmd_open(args, key)
    elif args.cmd == "move":
        cmd_move(args, key)
    elif args.cmd == "close":
        cmd_close(args, key)
    elif args.cmd == "shot":
        print(node(need_running(key)["port"], "shot", os.path.abspath(args.file)).stdout.strip())
    elif args.cmd == "note":
        update_ledger(key, note=args.text)
        print(f"noted: {key}")
    elif args.cmd == "url":
        print(node(need_running(key)["port"], "url").stdout.strip())
    elif args.cmd == "status":
        pids, port = running(PROFILE_ROOT / key)
        print(json.dumps({"key": key, "running": bool(pids), "port": port, "browser": CHROME,
                          "profile_root": str(PROFILE_ROOT), **(load_state(key) or {})}))


if __name__ == "__main__":
    main()

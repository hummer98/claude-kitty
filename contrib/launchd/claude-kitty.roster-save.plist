<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- claude-roster save（自動の保存）を 5 分ごとに走らせる（contrib/systemd/claude-roster-save.timer の macOS 版）。
     kitty が無いとき（落ちた直後など）は何も書かない。読むのは kitten @ ls と ~/.claude/sessions だけ。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>claude-kitty.roster-save</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@REPO@@/bin/claude-roster</string>
    <string>save</string>
    <string>--auto</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@@PATH@@</string>
    <key>HOME</key><string>@@HOME@@</string>@@EXTRA_ENV@@
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@@LOGDIR@@/roster-save.log</string>
  <key>StandardErrorPath</key><string>@@LOGDIR@@/roster-save.log</string>
</dict>
</plist>
